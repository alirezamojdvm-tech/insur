---
export interface Props {
  title: string;
  description: string;
  articleTitle: string;
}

const { title, description, articleTitle } = Astro.props;
const siteTitle = "مشاوره و ثبت‌نام انواع بیمه سامان | علیرضا محمدی (کد ۴۱۶۶۷۲)";
const fullName = "علیرضا محمدی";
const role = "مشاور تخصصی بیمه";
const company = "بیمه سامان";
const agentCode = "۴۱۶۶۷۲";
const siteUrl = "https://insur.hsc-co.ir";
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteUrl}/articles/${Astro.url.pathname.split('/').pop()}`} />
    <meta property="og:type" content="article" />
    <link rel="canonical" href={`${siteUrl}/articles/${Astro.url.pathname.split('/').pop()}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    
    <style is:global>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --bg: #EDF1FA;
        --surface: #FFFFFF;
        --primary: #173598;
        --primary-hover: #0F2678;
        --primary-light: #EBF0FD;
        --primary-mid: #C5D4F8;
        --gold: #B8720C;
        --gold-bg: #FDF4E3;
        --gold-border: #F0C87A;
        --text: #091832;
        --text-mid: #354567;
        --text-muted: #6578A0;
        --border: #DDE6F6;
        --r-card: 24px;
        --r-pill: 60px;
        --r-input: 14px;
      }

      body {
        font-family: 'Vazirmatn', 'Tahoma', sans-serif;
        background: var(--bg);
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 32px 16px 48px;
        color: var(--text);
        direction: rtl;
        line-height: 1.8;
      }

      .page {
        max-width: 860px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .card {
        background: var(--surface);
        border-radius: var(--r-card);
        border: 1px solid rgba(195, 212, 248, 0.7);
        box-shadow: 0 4px 20px rgba(20, 40, 110, 0.07);
        padding: 32px 36px;
      }

      .header-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 28px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: inherit;
      }
      .logo-icon {
        width: 42px;
        height: 42px;
        background: var(--primary);
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
      }
      .logo-text {
        font-size: 18px;
        font-weight: 800;
        color: var(--primary);
        letter-spacing: -0.3px;
      }

      .advisor {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .advisor-info { text-align: right; }
      .advisor-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
      }
      .advisor-role {
        font-size: 12px;
        color: var(--text-muted);
      }
      .advisor-code {
        font-size: 11px;
        color: var(--primary);
        background: var(--primary-light);
        padding: 2px 10px;
        border-radius: 20px;
        display: inline-block;
        margin-top: 4px;
        border: 1px solid var(--primary-mid);
      }
      .advisor-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 2.5px solid var(--primary);
        overflow: hidden;
        background: var(--primary-light);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 800;
        color: var(--primary);
      }
      .advisor-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .article-content {
        font-size: 16px;
        color: var(--text);
        line-height: 2;
      }

      .article-content h1 {
        font-size: 28px;
        font-weight: 900;
        color: var(--primary);
        margin-bottom: 18px;
      }

      .article-content h2 {
        font-size: 20px;
        font-weight: 800;
        color: var(--primary);
        margin-top: 30px;
        margin-bottom: 12px;
      }

      .article-content h3 {
        font-size: 17px;
        font-weight: 700;
        color: var(--text);
        margin-top: 20px;
        margin-bottom: 8px;
      }

      .article-content p {
        margin-bottom: 16px;
      }

      .article-content ul, .article-content ol {
        margin: 12px 20px 16px;
      }

      .article-content li {
        margin-bottom: 8px;
      }

      .article-content strong {
        color: var(--primary);
      }

      .article-content .highlight-box {
        background: var(--primary-light);
        border-right: 4px solid var(--primary);
        padding: 16px 20px;
        border-radius: 12px;
        margin: 20px 0;
      }

      .back-button {
        display: inline-block;
        background: var(--primary);
        color: #fff;
        padding: 12px 28px;
        border-radius: var(--r-pill);
        text-decoration: none;
        font-weight: 600;
        margin-top: 20px;
        transition: background 0.2s, transform 0.2s;
      }
      .back-button:hover {
        background: var(--primary-hover);
        transform: translateY(-2px);
      }

      .cta-box {
        background: var(--gold-bg);
        border: 1px solid var(--gold-border);
        border-radius: 16px;
        padding: 24px;
        margin-top: 30px;
        text-align: center;
      }
      .cta-box h3 {
        color: var(--gold);
        font-size: 18px;
      }
      .cta-box p {
        margin: 10px 0 16px;
        color: var(--text-mid);
      }
      .cta-button {
        display: inline-block;
        background: var(--gold);
        color: #fff;
        padding: 12px 32px;
        border-radius: var(--r-pill);
        text-decoration: none;
        font-weight: 700;
        transition: background 0.2s, transform 0.2s;
      }
      .cta-button:hover {
        background: #a0640a;
        transform: translateY(-2px);
      }

      @media (max-width: 600px) {
        body { padding: 16px 12px 40px; }
        .card { padding: 20px; }
        .header-card { flex-direction: column; align-items: flex-start; }
        .article-content h1 { font-size: 22px; }
        .article-content h2 { font-size: 18px; }
        .advisor-role { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- Header -->
      <header class="card header-card">
        <a href="/" class="logo">
          <div class="logo-icon">🛡️</div>
          <span class="logo-text">بیمه‌یار</span>
        </a>
        <div class="advisor">
          <div class="advisor-info">
            <div class="advisor-name">{fullName}</div>
            <div class="advisor-role">{role} | {company}</div>
            <span class="advisor-code">کد {agentCode}</span>
          </div>
          <div class="advisor-avatar">
            <img src="/images/avatar.jpg" alt={fullName} />
          </div>
        </div>
      </header>

      <!-- Article Content -->
      <article class="card article-content">
        <h1>{articleTitle}</h1>
        <slot />
      </article>

      <!-- Footer -->
      <footer class="card" style="text-align: center; padding: 16px 28px;">
        <p style="font-size: 12px; color: var(--text-muted);">
          🔒 اطلاعات شما کاملاً محفوظ است و تنها برای تماس استفاده می‌شود
        </p>
      </footer>
    </div>
  </body>
</html>