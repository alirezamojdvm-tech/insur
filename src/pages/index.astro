---
// src/pages/index.astro
const siteTitle = "بیمه‌یاری | مشاوره و ثبت‌نام بیمه";
const siteDescription = "ثبت‌نام بیمه با ۲۰۰ هزار تومان هدیه و همراهی در خسارت";
const siteUrl = "https://insur.hsc-co.ir";

// ⬇️ اطلاعات شخصی شما
const fullName = "علیرضا محمدی";
const role = "مشاور تخصصی بیمه";
const company = "بیمه سامان";
const agentCode = "۴۱۶۶۷۲";
const phone = "۰۹۱۲۴۹۱۷۸۲۲";
const linktree = "https://linktr.ee/alireza.mo.j.dvm";

// ⬇️ لینک عکس
const avatarUrl = "/images/avatar.jpg";
const formspreeId = "mlgqkeoz";

// ⬇️ لیست بیمه‌های مهم
const insuranceTypes = [
  { id: "third-party", label: "شخص ثالث خودرو", emoji: "🚗" },
  { id: "health", label: "تکمیل درمان", emoji: "🏥" },
  { id: "pet", label: "حیوانات خانگی", emoji: "🐾" },
  { id: "investment", label: "سرمایه‌گذاری", emoji: "📈" },
  { id: "body", label: "بدنه خودرو", emoji: "🛡️" },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={siteUrl} />
    
    <style>
      :root {
        --primary: #1a5fc7;
        --primary-hover: #0f4ba8;
        --accent: #f59e0b;
        --bg-grad-1: #f0f4fe;
        --bg-grad-2: #e2e8f0;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --white: #ffffff;
        --radius: 24px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Vazirmatn', 'Vazir', 'Tahoma', system-ui, sans-serif;
        background: linear-gradient(135deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        color: var(--text-dark);
      }

      /* انیمیشن ورود */
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
      }

      .container {
        max-width: 680px;
        width: 100%;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 40px;
        border-radius: var(--radius);
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.8);
        animation: fadeInUp 0.6s ease-out forwards;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 30px;
        padding-bottom: 24px;
        border-bottom: 2px dashed #e2e8f0;
      }

      .logo-placeholder {
        font-size: 24px;
        font-weight: 900;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .author-area {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #f8fafc;
        padding: 8px 16px 8px 8px;
        border-radius: 50px;
        border: 1px solid #e2e8f0;
      }

      .author-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--primary);
      }

      .author-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .author-info {
        display: flex;
        flex-direction: column;
      }

      .author-name {
        font-weight: 800;
        font-size: 15px;
      }

      .author-title {
        font-size: 12px;
        color: var(--text-muted);
      }

      .badge-wrapper {
        text-align: center;
        margin-bottom: 16px;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fef3c7;
        color: #b45309;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 800;
        border: 1px solid #fde68a;
        animation: pulse 2s infinite;
      }

      h1 {
        font-size: 28px;
        font-weight: 900;
        text-align: center;
        line-height: 1.4;
        margin-bottom: 8px;
        color: var(--text-dark);
      }

      h1 span {
        color: var(--primary);
      }

      .subtitle {
        text-align: center;
        color: var(--text-muted);
        font-size: 16px;
        margin-bottom: 30px;
      }

      .benefits {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 30px;
      }

      .benefit-item {
        background: #f1f5f9;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition);
      }
      
      .benefit-item:hover {
        background: #e2e8f0;
        transform: translateY(-2px);
      }

      .insurance-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 35px;
      }

      .insurance-item {
        background: var(--white);
        padding: 16px 12px;
        border-radius: 16px;
        border: 2px solid #e2e8f0;
        text-align: center;
        font-weight: 700;
        font-size: 14px;
        color: var(--text-dark);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        transition: var(--transition);
        cursor: default;
      }

      .insurance-item .emoji {
        font-size: 28px;
        background: #f8fafc;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
      }

      .insurance-item:hover {
        border-color: var(--primary);
        box-shadow: 0 10px 20px -10px rgba(26, 95, 199, 0.2);
        transform: translateY(-4px);
      }

      .form-section {
        background: #f8fafc;
        padding: 30px;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 8px;
        color: #334155;
      }

      input, select {
        width: 100%;
        padding: 16px;
        border: 2px solid #cbd5e1;
        border-radius: 14px;
        font-size: 15px;
        background: var(--white);
        transition: var(--transition);
        font-family: inherit;
      }

      input:focus, select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(26, 95, 199, 0.1);
      }

      .btn-submit {
        width: 100%;
        padding: 18px;
        background: var(--primary);
        color: var(--white);
        border: none;
        border-radius: 14px;
        font-size: 18px;
        font-weight: 800;
        cursor: pointer;
        transition: var(--transition);
        font-family: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }

      .btn-submit:hover {
        background: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -10px rgba(26, 95, 199, 0.4);
      }

      .btn-submit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
      }

      .linktree-btn {
        display: block;
        width: 100%;
        text-align: center;
        padding: 16px;
        margin-top: 12px;
        background: transparent;
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        transition: var(--transition);
      }

      .linktree-btn:hover {
        background: #e2e8f0;
        color: var(--text-dark);
      }

      .footer-note {
        text-align: center;
        margin-top: 24px;
        font-size: 13px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }

      .form-status {
        display: none;
        padding: 16px;
        border-radius: 12px;
        margin-top: 20px;
        text-align: center;
        font-weight: 700;
        font-size: 14px;
        animation: fadeInUp 0.3s ease;
      }

      .form-status.success {
        display: block;
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
      }

      .form-status.error {
        display: block;
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }

      @media (max-width: 600px) {
        .container { padding: 24px 20px; }
        .header { flex-direction: column; text-align: center; justify-content: center; }
        .form-section { padding: 20px 16px; }
        h1 { font-size: 24px; }
        .insurance-grid { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="container" id="app">
      
      <!-- هدر -->
      <header class="header">
        <div class="logo-placeholder">
          <span>🛡️</span> بیمه‌یاری
        </div>
        <div class="author-area">
          <div class="author-avatar">
            <!-- استفاده از متغیر عکس شما -->
            <img src={avatarUrl} alt={fullName} loading="lazy" />
          </div>
          <div class="author-info">
            <span class="author-name">{fullName}</span>
            <span class="author-title">{role} | نماینده {agentCode}</span>
          </div>
        </div>
      </header>

      <!-- عنوان و پیشنهاد ویژه -->
      <div class="badge-wrapper">
        <span class="badge">🎁 پیشنهاد ویژه تابستان</span>
      </div>
      
      <h1>ثبت‌نام بیمه با <span>۲۰۰ هزار تومان</span> هدیه!</h1>
      <p class="subtitle">بهترین پوشش بیمه‌ای + همراهی صفر تا صد در زمان خسارت</p>

      <!-- ویژگی‌های سریع -->
      <div class="benefits">
        <span class="benefit-item">✅ مشاوره رایگان</span>
        <span class="benefit-item">⚡ صدور فوری</span>
        <span class="benefit-item">🤝 پشتیبانی خسارت</span>
      </div>

      <!-- دسته‌بندی بیمه‌ها -->
      <div class="insurance-grid">
        {insuranceTypes.map((item) => (
          <div class="insurance-item">
            <span class="emoji">{item.emoji}</span>
            <span>{item.label}</span>
          </div>
        ))}
      </div>

      <!-- بخش فرم -->
      <div class="form-section">
        <!-- استفاده از متغیر Formspree -->
        <form id="insurance-form" action={`https://formspree.io/f/${formspreeId}`} method="POST">
          <div class="form-group">
            <label for="name">نام و نام خانوادگی</label>
            <input type="text" id="name" name="name" placeholder="مثال: علیرضا محمدی" required autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="phone">شماره تماس (موبایل)</label>
            <input type="tel" id="phone" name="phone" placeholder="۰۹۱۲۳۴۵۶۷۸۹" required dir="ltr" autocomplete="tel" />
          </div>

          <div class="form-group">
            <label for="insurance-type">نوع بیمه مورد نیاز شما</label>
            <select id="insurance-type" name="insurance-type" required>
              <option value="" disabled selected>یک مورد را انتخاب کنید...</option>
              {insuranceTypes.map((item) => (
                <option value={item.id}>{item.label}</option>
              ))}
            </select>
          </div>

          <button type="submit" class="btn-submit" id="submit-btn">
            <span>🚀</span> ثبت درخواست مشاوره
          </button>
          
          <!-- استفاده از متغیر Linktree -->
          <a href={linktree} target="_blank" rel="noopener noreferrer" class="linktree-btn">
            🔗 سایر راه‌های ارتباطی با من
          </a>
        </form>

        <div id="form-status" class="form-status"></div>
      </div>

      <div class="footer-note">
        <span>🔒</span> اطلاعات شما نزد ما کاملاً محفوظ است
      </div>
    </div>

    <script>
      const form = document.getElementById('insurance-form') as HTMLFormElement;
      const statusDiv = document.getElementById('form-status');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const originalBtnText = submitBtn.innerHTML;

      if (form && statusDiv && submitBtn) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          
          // تغییر حالت دکمه به "در حال ارسال"
          submitBtn.disabled = true;
          submitBtn.innerHTML = '⏳ در حال ارسال اطلاعات...';
          statusDiv.className = 'form-status';

          const formData = new FormData(form);

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { 'Accept': 'application/json' },
              body: formData,
            });

            if (response.ok) {
              statusDiv.className = 'form-status success';
              statusDiv.textContent = '✅ درخواست شما ثبت شد! به‌زودی تماس می‌گیرم.';
              form.reset();
            } else {
              throw new Error('Server response was not ok.');
            }
          } catch (error) {
            statusDiv.className = 'form-status error';
            statusDiv.textContent = '❌ مشکلی پیش آمد. لطفاً اتصال اینترنت را چک کنید یا مستقیم تماس بگیرید.';
          } finally {
            // بازگرداندن دکمه به حالت اولیه
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
            statusDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }
    </script>
  </body>
</html>