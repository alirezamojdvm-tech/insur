---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه بدنه خودرو سامان در ورامین، پاکدشت، پیشوا و قرچک | بازدید و صدور";
const description = "خرید بیمه بدنه سامان با پوشش سرقت و تصادفات در ورامین، پیشوا، قرچک و پاکدشت. استعلام قیمت، بازدید در محل و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// اسکیما مارک‌آپ پیشرفته برای بیمه بدنه (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور، کارشناسی و بازدید اولیه بیمه بدنه خودرو سامان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور و کارشناسی بیمه بدنه خودرو"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  {/* تزریق کدهای اسکیما برای شناسایی خدمات محلی توسط گوگل */}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <p>
    با توجه به افزایش چشمگیر قیمت خودرو و قطعات یدکی در ایران، خودرو به یکی از باارزش‌ترین دارایی‌های خانواده‌ها تبدیل شده است. تصادفات، سرقت، آتش‌سوزی و بلایای طبیعی می‌توانند در یک لحظه خسارت‌های جبران‌ناپذیری به همراه داشته باشند. <strong>بیمه بدنه</strong> دقیقاً سپر دفاعی شما در برابر این خطرات است.
  </p>

  <p>
    <strong>بیمه بدنه خودرو سامان</strong> با ارائه کامل‌ترین پوشش‌ها، خیال شما را از بابت سلامت سرمایه‌تان راحت می‌کند. ما در <strong>بیمه‌یار</strong>، خدمات مشاوره، استعلام قیمت و <strong>بازدید اولیه سریع</strong> را برای همشهریان عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به بهترین شکل ممکن هماهنگ و انجام می‌دهیم.
  </p>

  <h2>پوشش‌ها و مزایای بیمه بدنه سامان</h2>
  <p>
    با خرید این بیمه‌نامه از نمایندگی محلی خود، علاوه بر دسترسی سریع به کارشناس در زمان بروز خسارت، از مزایای زیر بهره‌مند می‌شوید:
  </p>

  <ul>
    <li><strong>🛡️ پوشش جامع خسارت‌های فیزیکی:</strong> جبران هزینه‌های ناشی از تصادفات، برخورد با اجسام ثابت و متحرک، واژگونی و سقوط.</li>
    <li><strong>🔒 سرقت درجا و سرقت کلی:</strong> پرداخت خسارت در صورت به سرقت رفتن کامل خودرو یا قطعات فابریک و غیرفابریک آن (مثل سیستم صوتی و لاستیک‌ها).</li>
    <li><strong>🌪️ بلایای طبیعی و آتش‌سوزی:</strong> جبران خسارات ناشی از سیل، زلزله، طوفان، صاعقه و انفجار.</li>
    <li><strong>🔧 پوشش‌های تکمیلی ویژه:</strong> امکان اضافه کردن پوشش نوسانات قیمت خودرو (حذف فرانشیز)، کشیدن میخ، اسیدپاشی و هزینه‌های ایاب و ذهاب در زمان تعمیرات.</li>
    <li><strong>⚡ بازدید و کارشناسی در منطقه شما:</strong> هماهنگی سریع و بی‌دردسر برای بازدید خودرو در شهرهای ورامین، قرچک، پیشوا و پاکدشت.</li>
  </ul>

  <div class="highlight-box">
    <strong>🛡️ به دنبال بیمه‌نامه‌ای مطمئن و مقرون‌به‌صرفه هستید؟</strong> همین حالا با <strong>علیرضا محمدی (کد ۴۱۶۶۷۲)</strong> تماس بگیرید. با ثبت‌نام از طریق سایت ما، علاوه بر دریافت بهترین مشاوره، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> نیز دریافت کنید.
  </div>

  <div class="cta-box">
    <h3>🛡️ استعلام قیمت و کارشناسی بیمه بدنه</h3>
    <p>برای محافظت از سرمایه خود، همین حالا فرم مشاوره را پر کنید تا در اسرع وقت با شما تماس بگیریم.</p>
    <a href="/#form" class="cta-button">دریافت مشاوره رایگان</a>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>