---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه کشاورزی سامان در ورامین، پاکدشت، پیشوا و قرچک | پوشش محصولات و دام";
const description = "خرید بیمه کشاورزی سامان با پوشش محصولات زراعی، باغی، دام و طیور در ورامین، پیشوا، قرچک و پاکدشت. مشاوره و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// اسکیما مارک‌آپ پیشرفته برای بیمه کشاورزی (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه کشاورزی سامان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور و مشاوره بیمه کشاورزی"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">🌾 ویژه کشاورزان و دامداران</span>
      <h1 class="hero-title">با <span class="highlight">بیمه کشاورزی</span> سامان، از سرمایه‌تان محافظت کنید</h1>
      <p class="hero-desc">
        پوشش کامل محصولات زراعی، باغی، دام و طیور در برابر بلایای طبیعی، آفات و بیماری‌ها. مخصوص کشاورزان و دامداران ورامین، پاکدشت، پیشوا و قرچک.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش خسارت‌های طبیعی</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۹۰%</span>
          <span class="stat-label">پوشش آفات و بیماری‌ها</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۴۸h</span>
          <span class="stat-label">بازدید کارشناس در محل</span>
        </div>
      </div>
      <a href="/#form" class="hero-cta">📞 دریافت مشاوره رایگان</a>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🌾</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه کشاورزی</span> در ورامین و پاکدشت ضروری است؟</h2>
        <p>
          <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> از قطب‌های مهم کشاورزی استان تهران هستند. با توجه به تغییرات اقلیمی، افزایش آفات و بیماری‌ها و بلایای طبیعی مانند سیل، تگرگ و سرمازدگی، بیمه کشاورزی یک نیاز اساسی برای تمامی کشاورزان و دامداران این مناطق است.
        </p>
        <p>
          <strong>بیمه کشاورزی سامان</strong> با ارائه پوشش‌های کامل و تخصصی، یکی از بهترین گزینه‌ها برای تأمین امنیت سرمایه‌های کشاورزی شماست. ما در <strong>بیمه‌یار</strong>، خدمات مشاوره تخصصی، <strong>بررسی زمین‌ها و دامداری‌ها</strong> و <strong>صدور فوری</strong> را برای همشهریان عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">🌾</span>
          <h4>محصولات زراعی</h4>
          <p>گندم، جو، ذرت، یونجه و سایر محصولات</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🍎</span>
          <h4>محصولات باغی</h4>
          <p>انواع میوه‌ها، پسته، گردو و مرکبات</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🐄</span>
          <h4>دام و طیور</h4>
          <p>گاو، گوسفند، مرغ، بوقلمون و آبزیان</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🏠</span>
          <h4>ماشین‌آلات کشاورزی</h4>
          <p>تراکتور، کمباین و ادوات کشاورزی</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه کشاورزی</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🌊</div>
        <h4>پوشش بلایای طبیعی</h4>
        <p>سیل، تگرگ، سرمازدگی، طوفان، خشکسالی و زلزله تحت پوشش کامل این بیمه قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🐛</div>
        <h4>پوشش آفات و بیماری‌ها</h4>
        <p>آفات گیاهی، بیماری‌های دام و طیور و خسارت‌های ناشی از علف‌های هرز تحت پوشش هستند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🚜</div>
        <h4>پوشش ماشین‌آلات</h4>
        <p>تراکتور، کمباین، سمپاش و سایر ادوات کشاورزی در برابر خسارت‌های ناشی از حوادث پوشش داده می‌شوند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👨‍🌾</div>
        <h4>پوشش حوادث کارگران</h4>
        <p>کارگران و کارکنان مزارع و دامداری‌ها در برابر حوادث کاری تحت پوشش قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>بازدید و کارشناسی سریع</h4>
        <p>کارشناسان ما در کمتر از ۴۸ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💰</div>
        <h4>پرداخت سریع خسارت</h4>
        <p>پرداخت خسارت در کوتاه‌ترین زمان ممکن پس از تأیید کارشناسان.</p>
      </div>
    </div>
  </div>

  <!-- بخش انواع بیمه کشاورزی -->
  <div class="types-section">
    <h2 class="section-title">📋 انواع <span class="highlight">بیمه کشاورزی</span> سامان</h2>
    <div class="types-grid">
      <div class="type-card">
        <span class="type-icon">🌾</span>
        <h4>بیمه محصولات زراعی</h4>
        <p>پوشش کامل گندم، جو، ذرت، برنج، یونجه و سایر محصولات زراعی در برابر بلایای طبیعی و آفات.</p>
        <ul>
          <li>پوشش سرمازدگی و تگرگ</li>
          <li>پوشش خشکسالی و سیل</li>
          <li>پوشش آفات و بیماری‌ها</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🍎</span>
        <h4>بیمه محصولات باغی</h4>
        <p>پوشش کامل باغ‌های میوه، پسته، گردو، بادام، مرکبات و سایر محصولات باغی.</p>
        <ul>
          <li>پوشش سرمازدگی بهاره و پاییزه</li>
          <li>پوشش تگرگ و طوفان</li>
          <li>پوشش آفات و بیماری‌های درختان</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🐄</span>
        <h4>بیمه دام و طیور</h4>
        <p>پوشش کامل گاو، گوسفند، بز، مرغ، بوقلمون، شترمرغ و آبزیان در برابر بیماری‌ها و حوادث.</p>
        <ul>
          <li>پوشش بیماری‌های واگیردار</li>
          <li>پوشش تلفات ناشی از حوادث</li>
          <li>پوشش هزینه‌های درمانی</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🚜</span>
        <h4>بیمه ماشین‌آلات کشاورزی</h4>
        <p>پوشش کامل تراکتور، کمباین، سمپاش، دروگر و سایر ادوات کشاورزی.</p>
        <ul>
          <li>پوشش خسارت‌های ناشی از حوادث</li>
          <li>پوشش سرقت و آتش‌سوزی</li>
          <li>پوشش هزینه‌های تعمیرات</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- بخش پوشش‌ها -->
  <div class="coverage-section">
    <h2 class="section-title">🛡️ پوشش‌های <span class="highlight">بیمه کشاورزی</span> سامان</h2>
    <div class="coverage-grid">
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>بلایای طبیعی</h4>
          <p>سیل، تگرگ، سرمازدگی، طوفان، خشکسالی و زلزله</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>آفات و بیماری‌ها</h4>
          <p>آفات گیاهی، بیماری‌های دام و طیور، علف‌های هرز</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>حوادث کارگران</h4>
          <p>حوادث ناشی از کار در مزارع و دامداری‌ها</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>ماشین‌آلات کشاورزی</h4>
          <p>حوادث، سرقت، آتش‌سوزی و هزینه‌های تعمیرات</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>سرمایه‌گذاری در مزرعه</h4>
          <p>پوشش هزینه‌های آماده‌سازی زمین، کود، سم و بذر</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>مسئولیت مدنی کشاورز</h4>
          <p>پوشش خسارت‌های وارده به اشخاص ثالث</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش سوالات متداول -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> کشاورزان</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا بیمه کشاورزی، خسارت ناشی از تگرگ را پوشش می‌دهد؟</h4>
        <p>بله، بیمه کشاورزی سامان به طور کامل خسارت‌های ناشی از تگرگ، سرمازدگی، سیل، طوفان و سایر بلایای طبیعی را پوشش می‌دهد. این پوشش برای تمامی محصولات زراعی، باغی و دامی اعمال می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>آیا می‌توانم بیمه دام و طیور را جداگانه خریداری کنم؟</h4>
        <p>بله، شما می‌توانید بیمه دام و طیور را به صورت جداگانه یا همراه با سایر بیمه‌نامه‌های کشاورزی خریداری کنید. برای اطلاع از شرایط و قیمت، با کارشناسان ما تماس بگیرید.</p>
      </div>
      <div class="faq-item">
        <h4>چگونه می‌توانم خسارت خود را ثبت کنم؟</h4>
        <p>برای ثبت خسارت، با کارشناسان ما تماس بگیرید. تیم کارشناسی ما در کمتر از ۴۸ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پس از تأیید، خسارت در کوتاه‌ترین زمان پرداخت می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه کشاورزی، هزینه‌های آماده‌سازی زمین را پوشش می‌دهد؟</h4>
        <p>بله، برخی از طرح‌های بیمه کشاورزی سامان شامل پوشش هزینه‌های آماده‌سازی زمین، خرید کود، سم و بذر نیز می‌شوند. برای اطلاع از جزئیات، با کارشناسان ما مشورت کنید.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🌾 با <span class="highlight-light">بیمه کشاورزی</span> سامان از سرمایه‌تان محافظت کنید</h2>
      <p>با ثبت‌نام در بیمه کشاورزی سامان، از پوشش کامل محصولات، دام، طیور و ماشین‌آلات در برابر بلایای طبیعی، آفات و بیماری‌ها بهره‌مند شوید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09025472929" class="cta-secondary">📱 تماس فوری: 09025472929</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

