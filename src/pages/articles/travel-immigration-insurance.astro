    font-size: 3rem;
    display: block;
    margin-bottom: 12px;
  }
  .feature-card h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: #1e3a8a;
  }
  .feature-card p {
