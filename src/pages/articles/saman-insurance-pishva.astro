---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه سامان در پیشوا | بهترین نمایندگی بیمه سامان (کد ۴۱۶۶۷۲) | علیرضا محمدی";
const description = "نمایندگی رسمی بیمه سامان در پیشوا با کد ۴۱۶۶۷۲. ارائه انواع بیمه‌نامه‌های خودرو، درمان، عمر، کشاورزی و ... با مشاوره رایگان و هدیه نقدی ۲۰۰ هزار تومانی.";

// اسکیما مارک‌آپ پیشرفته برای برندینگ محلی (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲) - پیشوا",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره انواع بیمه‌های سامان در پیشوا و جنوب شرق استان تهران.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "پیشوا",
    "addressRegion": "تهران",
    "addressCountry": "IR"
  },
  "areaServed": [
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پاکدشت" },
    { "@type": "City", "name": "قرچک" }
  ],
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": "بیمه شخص ثالث" }
    },
    {
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": "بیمه بدنه خودرو" }
    },
    {
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": "بیمه تکمیلی درمان" }
    },
    {
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": "بیمه عمر و پس‌انداز" }
    },
    {
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": "بیمه کشاورزی" }
    }
  ],
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی",
    "identifier": "۴۱۶۶۷۲"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب محلی -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">📍 نمایندگی رسمی بیمه سامان در پیشوا</span>
      <h1 class="hero-title">بهترین <span class="highlight">بیمه سامان</span> در پیشوا با کد <span class="highlight">۴۱۶۶۷۲</span></h1>
      <p class="hero-desc">
        انواع بیمه‌نامه‌های خودرو، درمان، عمر، کشاورزی، دام و طیور و ... با مشاوره رایگان، هدیه نقدی ۲۰۰ هزار تومانی و همراهی کامل در فرآیند خسارت.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۱۰+</span>
          <span class="stat-label">سال سابقه در پیشوا</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۳۰۰+</span>
          <span class="stat-label">مشتری راضی در پیشوا</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۴.۹</span>
          <span class="stat-label">امتیاز از ۵ (رضایت مشتریان)</span>
        </div>
      </div>
      <div class="hero-buttons">
        <a href="/#form" class="hero-cta primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="hero-cta secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🏛️</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">نمایندگی بیمه سامان در پیشوا</span> با کد ۴۱۶۶۷۲؟</h2>
        <p>
          <strong>علیرضا محمدی</strong> با کد نمایندگی <strong>۴۱۶۶۷۲</strong>، یکی از مجرب‌ترین و معتبرترین نمایندگان بیمه سامان در <strong>پیشوا</strong> و جنوب شرق استان تهران است. با بیش از ۱۰ سال سابقه درخشان در صنعت بیمه، هزاران مشتری راضی در پیشوا و شهرهای همجوار داشته است.
        </p>
        <p>
          <strong>پیشوا</strong> با داشتن زمین‌های کشاورزی حاصلخیز، دامداری‌های فعال و جمعیت رو به رشد، یکی از مناطق کلیدی در جنوب شرق تهران است. ما در <strong>بیمه‌یار</strong>، تمامی خدمات بیمه‌ای از جمله <strong>بیمه شخص ثالث، بدنه خودرو، تکمیلی درمان، عمر و پس‌انداز، کشاورزی، دام و طیور و ...</strong> را با بهترین شرایط و قیمت به همشهریان عزیز در <strong>پیشوا</strong> ارائه می‌دهیم.
        </p>
        <div class="trust-badges">
          <span class="badge">✅ نمایندگی رسمی بیمه سامان</span>
          <span class="badge">✅ کد نمایندگی: ۴۱۶۶۷۲</span>
          <span class="badge">✅ بیش از ۱۰ سال سابقه</span>
          <span class="badge">✅ همراهی در خسارت</span>
        </div>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">🏆</span>
          <h4>بیش از ۱۰ سال تجربه</h4>
          <p>سابقه درخشان در صنعت بیمه پیشوا</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">⭐</span>
          <h4>رضایت ۹۸ درصدی</h4>
          <p>مشتریان راضی در پیشوا و منطقه</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🚀</span>
          <h4>صدور فوری</h4>
          <p>بیمه‌نامه در کمترین زمان ممکن</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🎁</span>
          <h4>هدیه ۲۰۰ هزار تومانی</h4>
          <p>به ازای هر ثبت‌نام</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش خدمات -->
  <div class="services-section">
    <h2 class="section-title">📋 انواع <span class="highlight">بیمه‌نامه‌های سامان</span> در پیشوا</h2>
    <div class="services-grid">
      <div class="service-card">
        <span class="service-icon">🚗</span>
        <h4>بیمه شخص ثالث</h4>
        <p>پوشش کامل حوادث رانندگی با تخفیف‌های بدون خسارت تا ۷۰٪</p>
        <a href="/articles/third-party" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">🛡️</span>
        <h4>بیمه بدنه خودرو</h4>
        <p>پوشش تصادفات، سرقت، آتش‌سوزی و بلایای طبیعی</p>
        <a href="/articles/body-insurance" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">🏥</span>
        <h4>بیمه تکمیلی درمان</h4>
        <p>پوشش هزینه‌های بستری، جراحی، پاراکلینیک و دندانپزشکی</p>
        <a href="/articles/supplementary-health-insurance" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">💰</span>
        <h4>بیمه عمر و پس‌انداز</h4>
        <p>سرمایه‌گذاری مطمئن با بازدهی تضمینی و پوشش فوت</p>
        <a href="/articles/life-savings-insurance" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">🌾</span>
        <h4>بیمه کشاورزی</h4>
        <p>پوشش محصولات زراعی، باغی، دام و طیور در برابر بلایای طبیعی</p>
        <a href="/articles/agriculture-insurance" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">🐄</span>
        <h4>بیمه دام و طیور</h4>
        <p>پوشش بیماری‌ها، تلفات و حوادث دام و طیور</p>
        <a href="/articles/livestock-insurance-gharchak-pishva" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">🏭</span>
        <h4>بیمه کارگاه‌های صنعتی</h4>
        <p>پوشش ماشین‌آلات، حوادث کارگران و مسئولیت مدنی</p>
        <a href="/articles/industrial-workshop-insurance" class="service-link">اطلاعات بیشتر →</a>
      </div>
      <div class="service-card">
        <span class="service-icon">⚖️</span>
        <h4>بیمه مسئولیت کارفرما</h4>
        <p>پوشش حوادث کارگران و مسئولیت مدنی کارفرمایان</p>
        <a href="/articles/employer-liability-insurance" class="service-link">اطلاعات بیشتر →</a>
      </div>
    </div>
  </div>

  <!-- بخش مزایای محلی -->
  <div class="local-features">
    <h2 class="section-title">✨ چرا ساکنان <span class="highlight">پیشوا</span> به ما اعتماد دارند؟</h2>
    <div class="local-grid">
      <div class="local-card">
        <span class="local-icon">📍</span>
        <h4>دسترسی آسان در پیشوا</h4>
        <p>هماهنگی سریع برای بازدید و مشاوره در محل در پیشوا و مناطق اطراف</p>
      </div>
      <div class="local-card">
        <span class="local-icon">👨‍💼</span>
        <h4>کارشناسان بومی پیشوا</h4>
        <p>تیم کارشناسی ما با فرهنگ و نیازهای مردم پیشوا آشنا هستند</p>
      </div>
      <div class="local-card">
        <span class="local-icon">⚡</span>
        <h4>صدور فوری و آنلاین</h4>
        <p>بدون نیاز به حضور فیزیکی، بیمه‌نامه را در منزل یا محل کار تحویل بگیرید</p>
      </div>
      <div class="local-card">
        <span class="local-icon">🎁</span>
        <h4>هدیه ویژه پیشوایی‌ها</h4>
        <p>۲۰۰ هزار تومان هدیه نقدی به ازای هر ثبت‌نام</p>
      </div>
    </div>
  </div>

  <!-- بخش نظرات مشتریان -->
  <div class="testimonials-section">
    <h2 class="section-title">💬 نظرات <span class="highlight">مشتریان</span> در پیشوا</h2>
    <div class="testimonials-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
        <p class="testimonial-text">
          "آقای محمدی بهترین مشاور بیمه‌ای در پیشوا هستند. برای بیمه کشاورزی با ایشان مشورت کردم و واقعاً از راهنمایی‌هایش راضی‌ام."
        </p>
        <div class="testimonial-author">
          <strong>علی اکبری</strong>
          <span>پیشوا - جاده قدیم</span>
        </div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
        <p class="testimonial-text">
          "بیمه دام و طیور رو از طریق آقای محمدی گرفتم. خیلی سریع و دقیق کار رو انجام دادن. ممنونم از خدمات خوبشون."
        </p>
        <div class="testimonial-author">
          <strong>محمد رضایی</strong>
          <span>پیشوا - روستای گلزار</span>
        </div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
        <p class="testimonial-text">
          "برای بیمه تکمیلی درمان مشاوره گرفتم. کارشناسشون بهترین گزینه رو پیشنهاد دادن. عالی بود."
        </p>
        <div class="testimonial-author">
          <strong>زهرا کریمی</strong>
          <span>پیشوا - خیابان امام خمینی</span>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش FAQ محلی -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> درباره بیمه سامان در پیشوا</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>نمایندگی بیمه سامان در پیشوا کجاست؟</h4>
        <p>ما به صورت سیار و با هماهنگی قبلی در سراسر پیشوا ارائه خدمات می‌دهیم. با کارشناسان ما تماس بگیرید تا در محل شما حضور پیدا کنند.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه‌نامه‌های سامان در پیشوا معتبر هستند؟</h4>
        <p>بله، تمامی بیمه‌نامه‌های صادره توسط نمایندگی رسمی بیمه سامان (کد ۴۱۶۶۷۲) کاملاً معتبر و قابل پیگیری در سراسر کشور هستند.</p>
      </div>
      <div class="faq-item">
        <h4>چگونه می‌توانم بیمه خود را در پیشوا تمدید کنم؟</h4>
        <p>با تماس با کارشناسان ما، بیمه‌نامه شما در کمترین زمان ممکن تمدید می‌شود و بیمه‌نامه جدید برای شما ارسال می‌گردد.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه سامان در پیشوا، خدمات خسارت دارد؟</h4>
        <p>بله، ما همراهی کامل در فرآیند خسارت تا دریافت کامل خسارت را برای مشتریان خود در پیشوا انجام می‌دهیم.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🏛️ با <span class="highlight-light">نمایندگی رسمی بیمه سامان</span> در پیشوا همراه شوید</h2>
      <p>با ثبت‌نام از طریق نمایندگی رسمی بیمه سامان با کد ۴۱۶۶۷۲، از مشاوره رایگان، هدیه نقدی ۲۰۰ هزار تومانی و همراهی کامل در خسارت بهره‌مند شوید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="cta-secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
      <p class="cta-note">📍 ارائه خدمات در پیشوا، ورامین، پاکدشت و قرچک</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #fcd34d;
    text-shadow: 0 2px 8px rgba(252,211,77,0.3);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #fcd34d;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-cta {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .hero-cta.primary {
    background: white;
    color: #1e3a8a;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta.primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
  .hero-cta.secondary {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 2px solid rgba(255,255,255,0.3);
  }
  .hero-cta.secondary:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-3px);
  }
  .hero-image {
    flex: 0 0 120px;
    text-align: center;
  }
  .hero-icon {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== بخش معرفی ===== */
  .intro-section {
    margin: 40px 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .intro-text h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .intro-text .highlight {
    color: #1e3a8a;
    font-weight: 700;
  }
  .intro-text p {
    line-height: 1.8;
    color: #333;
    margin-bottom: 12px;
  }
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .badge {
    background: #eff6ff;
    color: #1e3a8a;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid #bfdbfe;
  }
  .intro-benefits {
