---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی محلی برای سئو
const title = "بیمه حیوانات خانگی سامان در ورامین، پاکدشت، پیشوا و قرچک";
const description = "صدور بیمه حیوانات خانگی سامان با پوشش هزینه‌های درمانی و جراحی در ورامین، پیشوا، قرچک و پاکدشت. مشاوره رایگان با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// کدهای اسکیما (Schema Markup) برای معرفی به عنوان کسب‌وکار محلی
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "نمایندگی بیمه سامان - علیرضا محمدی (کد ۴۱۶۶۷۲)",
  "description": "ارائه دهنده خدمات بیمه حیوانات خانگی سامان در شهرهای ورامین، پیشوا، قرچک و پاکدشت.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  {/* تزریق دینامیک کد اسکیما به هدر این صفحه بدون تداخل با لایوت */}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <p>
    حیوانات خانگی مانند سگ و گربه، عضو جدایی‌ناپذیر خانواده‌های بسیاری شده‌اند. هزینه‌های درمانی و بهداشتی این موجودات دوست‌داشتنی می‌تواند بسیار بالا باشد. آیا می‌دانستید که می‌توانید برای حیوان خانگی خود نیز <strong>بیمه‌نامه‌ی اختصاصی</strong> خریداری کنید؟
  </p>

  <p>
    <strong>بیمه حیوانات خانگی سامان</strong> یکی از جدیدترین و کاربردی‌ترین خدمات بیمه‌ای در ایران است که پوشش‌های متنوعی را ارائه می‌دهد:
  </p>

  <ul>
    <li><strong>🐾 هزینه‌های درمانی:</strong> پوشش هزینه‌های ویزیت، دارو، آزمایش‌ها و جراحی‌های حیوان خانگی</li>
    <li><strong>🐶 هزینه‌های واکسیناسیون و پیشگیری:</strong> پوشش بخشی از هزینه‌های واکسن‌های دوره‌ای و خدمات پیشگیرانه</li>
    <li><strong>🩺 بیماری‌های خاص:</strong> برخی از بیماری‌های خاص و مزمن حیوانات نیز تحت پوشش قرار می‌گیرند.</li>
  </ul>

  <h2>مناطق تحت پوشش خدمات ما</h2>
  <p>
    ما افتخار داریم که خدمات مشاوره و صدور <strong>بیمه حیوانات خانگی سامان</strong> را به صورت تخصصی و سریع به همشهریان عزیز در شهرستان‌های <strong>ورامین، پیشوا، قرچک و پاکدشت</strong> ارائه دهیم. شما می‌توانید بدون نیاز به مراجعه حضوری، تمامی مراحل ثبت‌نام و دریافت بیمه‌نامه را انجام دهید.
  </p>

  <h2>مزایای بیمه حیوانات خانگی سامان</h2>
  <ul>
    <li>✅ حق‌بیمه‌ی مناسب نسبت به پوشش‌ها</li>
    <li>✅ امکان استفاده از کلینیک‌های معتبر طرف قرارداد</li>
    <li>✅ فرآیند ساده‌ی ثبت‌نام و دریافت خسارت</li>
    <li>✅ مشاوره‌ی تخصصی پیش از خرید</li>
  </ul>

  <div class="highlight-box">
    <strong>🐾 اگر حیوان خانگی دارید،</strong> با خرید این بیمه‌نامه از <strong>علیرضا محمدی (کد ۴۱۶۶۷۲)</strong> نه‌تنها از سلامت دوست پشمالوی خود مطمئن می‌شوید، بلکه <strong>۲۰۰ هزار تومان هدیه</strong> نیز دریافت می‌کنید.
  </div>

  <div class="cta-box">
    <h3>🐾 از حیوان خانگی خود محافظت کنید</h3>
    <p>همین حالا برای حیوان خانگی خود بیمه تهیه کنید.</p>
    <a href="/#form" class="cta-button">دریافت مشاوره رایگان</a>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>
