---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه گندم‌کاران ورامین | بیمه محصولات کشاورزی سامان (کد ۴۱۶۶۷۲) | علیرضا محمدی";
const description = "بیمه گندم‌کاران ورامین با پوشش سرمازدگی، تگرگ، خشکسالی، آفات و بیماری‌ها. مشاوره رایگان و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲) در ورامین و جنوب شرق تهران.";

// اسکیما مارک‌آپ پیشرفته برای بیمه گندم (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲) - ورامین",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه گندم‌کاران در ورامین و جنوب شرق استان تهران.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "ورامین",
    "addressRegion": "تهران",
    "addressCountry": "IR"
  },
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پاکدشت" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "بیمه گندم‌کاران"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی",
    "identifier": "۴۱۶۶۷۲"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب محلی -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">🌾 ویژه گندم‌کاران ورامین</span>
      <h1 class="hero-title">با <span class="highlight">بیمه گندم‌کاران</span> سامان، از سرمایه‌تان محافظت کنید</h1>
      <p class="hero-desc">
        پوشش کامل محصولات گندم در برابر سرمازدگی، تگرگ، خشکسالی، آفات و بیماری‌ها. با مشاوره رایگان و هدیه نقدی ۲۰۰ هزار تومانی.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۸٬۰۰۰+</span>
          <span class="stat-label">هکتار سطح زیر کشت گندم در ورامین</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش خسارت‌های طبیعی</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۴۸h</span>
          <span class="stat-label">بازدید کارشناس در محل</span>
        </div>
      </div>
      <div class="hero-buttons">
        <a href="/#form" class="hero-cta primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="hero-cta secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🌾</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه گندم‌کاران</span> در ورامین ضروری است؟</h2>
        <p>
          <strong>شهرستان ورامین</strong> با بیش از ۸٬۰۰۰ هکتار سطح زیر کشت گندم، یکی از قطب‌های اصلی تولید این محصول استراتژیک در استان تهران است. با توجه به تغییرات اقلیمی، افزایش آفات و بیماری‌ها و بلایای طبیعی مانند <strong>سرمازدگی، تگرگ و خشکسالی</strong>، بیمه گندم یک نیاز اساسی برای تمامی کشاورزان این منطقه است.
        </p>
        <p>
          <strong>بیمه گندم‌کاران سامان</strong> با ارائه پوشش‌های کامل و تخصصی، یکی از بهترین گزینه‌ها برای تأمین امنیت سرمایه‌های کشاورزی شماست. ما در <strong>بیمه‌یار</strong> با کد ۴۱۶۶۷۲، خدمات مشاوره تخصصی، <strong>بررسی مزارع</strong> و <strong>صدور فوری</strong> را برای گندم‌کاران عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
        <div class="trust-badges">
          <span class="badge">✅ نمایندگی رسمی بیمه سامان</span>
          <span class="badge">✅ کد نمایندگی: ۴۱۶۶۷۲</span>
          <span class="badge">✅ بیش از ۱۰ سال سابقه</span>
          <span class="badge">✅ همراهی در خسارت</span>
        </div>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">❄️</span>
          <h4>پوشش سرمازدگی</h4>
          <p>خسارت ناشی از سرمازدگی پاییزه و بهاره</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🌨️</span>
          <h4>پوشش تگرگ</h4>
          <p>خسارت ناشی از تگرگ و طوفان</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">☀️</span>
          <h4>پوشش خشکسالی</h4>
          <p>خسارت ناشی از کم‌آبی و تنش خشکی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🐛</span>
          <h4>پوشش آفات و بیماری‌ها</h4>
          <p>آفات و بیماری‌های گندم و جو</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش اطلاعات گندم ورامین -->
  <div class="local-info-section">
    <h2 class="section-title">📊 <span class="highlight">گندم ورامین</span> در یک نگاه</h2>
    <div class="local-info-grid">
      <div class="info-card">
        <span class="info-number">۸٬۰۰۰+</span>
        <p>هکتار سطح زیر کشت گندم</p>
      </div>
      <div class="info-card">
        <span class="info-number">۴۰٬۰۰۰+</span>
        <p>تن تولید گندم در سال</p>
      </div>
      <div class="info-card">
        <span class="info-number">۱,۵۰۰+</span>
        <p>گندم‌کار فعال در ورامین</p>
      </div>
      <div class="info-card">
        <span class="info-number">۳۰%</span>
        <p>سهم شهرستان ورامین از تولید گندم استان</p>
      </div>
    </div>
    <p class="info-note">
      با توجه به اهمیت گندم در اقتصاد منطقه و کشور، بیمه کردن مزارع یک ضرورت انکارناپذیر است.
    </p>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه گندم‌کاران</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">❄️</div>
        <h4>پوشش سرمازدگی پاییزه و بهاره</h4>
        <p>محصولات گندم و جو در برابر سرمازدگی پاییزه (قبل از پنجه‌زنی) و بهاره (بعد از پنجه‌زنی) تحت پوشش کامل قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌨️</div>
        <h4>پوشش تگرگ و طوفان</h4>
        <p>خسارت ناشی از تگرگ، طوفان و بادهای شدید که باعث خوابیدگی و ریزش محصول می‌شوند، به طور کامل پوشش داده می‌شود.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">☀️</div>
        <h4>پوشش خشکسالی و تنش رطوبتی</h4>
        <p>خسارت ناشی از کم‌آبی، تنش خشکی و گرما در مراحل مختلف رشد گندم تحت پوشش قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🐛</div>
        <h4>پوشش آفات و بیماری‌ها</h4>
        <p>آفات مهم گندم مانند سن، شته، زنجره، کرم‌های برگ‌خوار و بیماری‌هایی مانند زنگ‌ها، سفیدک‌ها و فوزاریوم تحت پوشش این بیمه قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🚜</div>
        <h4>پوشش هزینه‌های کشت</h4>
        <p>هزینه‌های آماده‌سازی زمین، بذر، کود، سم و سایر نهاده‌های کشاورزی تحت پوشش بیمه قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>بازدید و کارشناسی سریع</h4>
        <p>کارشناسان ما در کمتر از ۴۸ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پرداخت خسارت در کوتاه‌ترین زمان ممکن انجام می‌شود.</p>
      </div>
    </div>
  </div>

  <!-- بخش مراحل بیمه -->
  <div class="process-section">
    <h2 class="section-title">📋 مراحل <span class="highlight">ثبت‌نام</span> بیمه گندم</h2>
    <div class="process-grid">
      <div class="process-item">
        <span class="process-number">۱</span>
        <h4>مشاوره رایگان</h4>
        <p>تماس با کارشناسان برای بررسی نیازهای مزرعه شما</p>
      </div>
      <div class="process-item">
        <span class="process-number">۲</span>
        <h4>بازدید از مزرعه</h4>
        <p>کارشناسان ما از مزرعه شما بازدید کرده و ریسک‌ها را ارزیابی می‌کنند</p>
      </div>
      <div class="process-item">
        <span class="process-number">۳</span>
        <h4>تعیین پوشش و حق بیمه</h4>
        <p>انتخاب بهترین پوشش‌ها و محاسبه حق بیمه بر اساس سطح زیر کشت</p>
      </div>
      <div class="process-item">
        <span class="process-number">۴</span>
        <h4>صدور بیمه‌نامه</h4>
        <p>صدور بیمه‌نامه پس از تأیید و پرداخت</p>
      </div>
    </div>
  </div>

  <!-- بخش تقویم کشت گندم در ورامین -->
  <div class="calendar-section">
    <h2 class="section-title">📅 تقویم <span class="highlight">کشت گندم</span> در ورامین</h2>
    <div class="calendar-grid">
      <div class="calendar-item">
        <span class="calendar-month">🌧️ مهر</span>
        <p>آماده‌سازی زمین و شروع کشت</p>
      </div>
      <div class="calendar-item">
        <span class="calendar-month">🌱 آبان</span>
        <p>سبز شدن و پنجه‌زنی</p>
      </div>
      <div class="calendar-item">
        <span class="calendar-month">❄️ آذر-بهمن</span>
        <p>دوره خواب زمستانی (خطر سرمازدگی)</p>
      </div>
      <div class="calendar-item">
        <span class="calendar-month">🌸 اسفند-فروردین</span>
        <p>رشد مجدد و ساقه‌دهی (خطر تگرگ)</p>
      </div>
      <div class="calendar-item">
        <span class="calendar-month">🌾 اردیبهشت</span>
        <p>خوشه‌دهی و پر شدن دانه</p>
      </div>
      <div class="calendar-item">
        <span class="calendar-month">🚜 خرداد</span>
        <p>رسیدگی و برداشت محصول</p>
      </div>
    </div>
    <p class="calendar-note">
      زمان‌های مناسب برای بیمه محصولات خود را از دست ندهید. با ما تماس بگیرید تا بهترین زمان بیمه را به شما پیشنهاد دهیم.
    </p>
  </div>

  <!-- بخش سوالات متداول -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> گندم‌کاران ورامین</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا بیمه گندم، خسارت ناشی از سرمازدگی بهاره را پوشش می‌دهد؟</h4>
        <p>بله، بیمه گندم‌کاران سامان به طور کامل خسارت‌های ناشی از سرمازدگی بهاره (بعد از پنجه‌زنی) را پوشش می‌دهد. این یکی از مهم‌ترین پوشش‌هایی است که گندم‌کاران در ورامین به آن نیاز دارند.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه گندم، خسارت ناشی از آفت سن را پوشش می‌دهد؟</h4>
        <p>بله، آفت سن یکی از مهم‌ترین آفات گندم در ورامین است و بیمه گندم‌کاران سامان به طور کامل خسارت ناشی از این آفت را پوشش می‌دهد.</p>
      </div>
      <div class="faq-item">
        <h4>چگونه می‌توانم خسارت مزرعه خود را ثبت کنم؟</h4>
        <p>برای ثبت خسارت، با کارشناسان ما تماس بگیرید. تیم کارشناسی ما در کمتر از ۴۸ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پس از تأیید، خسارت در کوتاه‌ترین زمان پرداخت می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>آیا می‌توانم بیمه گندم را پس از کشت خریداری کنم؟</h4>
        <p>بله، شما می‌توانید بیمه گندم را تا مرحله پنجه‌زنی خریداری کنید. برای اطلاع از آخرین مهلت ثبت‌نام، با کارشناسان ما تماس بگیرید.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🌾 با <span class="highlight-light">بیمه گندم‌کاران</span> سامان از سرمایه‌تان محافظت کنید</h2>
      <p>با ثبت‌نام در بیمه گندم‌کاران سامان، از پوشش کامل سرمازدگی، تگرگ، خشکسالی، آفات و بیماری‌ها بهره‌مند شوید و خیال خود را از بابت خسارت‌های احتمالی راحت کنید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09025472929" class="cta-secondary">📱 تماس فوری: 09025472929</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #92400e 0%, #b45309 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #fcd34d;
    text-shadow: 0 2px 8px rgba(252,211,77,0.3);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #fcd34d;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-cta {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .hero-cta.primary {
    background: white;
    color: #92400e;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta.primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
  .hero-cta.secondary {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 2px solid rgba(255,255,255,0.3);
  }
  .hero-cta.secondary:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-3px);
  }
  .hero-image {
    flex: 0 0 120px;
    text-align: center;
  }
  .hero-icon {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== بخش معرفی ===== */
  .intro-section {
    margin: 40px 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .intro-text h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .intro-text .highlight {
    color: #92400e;
    font-weight: 700;
  }
  .intro-text p {
    line-height: 1.8;
    color: #333;
    margin-bottom: 12px;
  }
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .badge {
    background: #fffbeb;
    color: #92400e;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid #fcd34d;
  }
  .intro-benefits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .benefit-card {
    background: #f8fafc;
    padding: 20px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }
  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    border-color: #b45309;
  }
  .benefit-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 8px;
  }
  .benefit-card h4 {
