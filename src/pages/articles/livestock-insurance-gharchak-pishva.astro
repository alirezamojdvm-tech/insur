---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه دامداران قرچک و پیشوا | بیمه دام و طیور سامان (کد ۴۱۶۶۷۲) | علیرضا محمدی";
const description = "بیمه دامداران قرچک و پیشوا با پوشش گاو، گوسفند، بز، طیور و آبزیان. مشاوره رایگان و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲) در قرچک، پیشوا و جنوب شرق تهران.";

// اسکیما مارک‌آپ پیشرفته برای بیمه دام (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲) - قرچک و پیشوا",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه دامداران در قرچک، پیشوا و جنوب شرق استان تهران.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "قرچک",
    "addressRegion": "تهران",
    "addressCountry": "IR"
  },
  "areaServed": [
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "بیمه دامداران"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی",
    "identifier": "۴۱۶۶۷۲"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب محلی -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">🐄 ویژه دامداران قرچک و پیشوا</span>
      <h1 class="hero-title">با <span class="highlight">بیمه دامداران</span> سامان، از سرمایه‌تان محافظت کنید</h1>
      <p class="hero-desc">
        پوشش کامل گاو، گوسفند، بز، طیور و آبزیان در برابر بیماری‌ها، تلفات و حوادث. با مشاوره رایگان و هدیه نقدی ۲۰۰ هزار تومانی.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۲۰۰+</span>
          <span class="stat-label">دامداری فعال در قرچک و پیشوا</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش بیماری‌های واگیردار</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۲۴h</span>
          <span class="stat-label">بازدید کارشناس در محل</span>
        </div>
      </div>
      <div class="hero-buttons">
        <a href="/#form" class="hero-cta primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="hero-cta secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🐄</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه دامداران</span> در قرچک و پیشوا ضروری است؟</h2>
        <p>
          <strong>قرچک و پیشوا</strong> با داشتن دامداری‌های صنعتی و سنتی متعدد، یکی از قطب‌های مهم تولید شیر، گوشت و فرآورده‌های دامی در جنوب شرق تهران هستند. بیماری‌های واگیردار مانند <strong>تب برفکی، لمپی‌اسکین، طاعون نشخوارکنندگان و آنفلوانزای فوق‌حاد طیور</strong> می‌توانند خسارت‌های جبران‌ناپذیری به دامداران وارد کنند.
        </p>
        <p>
          <strong>بیمه دامداران سامان</strong> با ارائه پوشش‌های کامل و تخصصی، یکی از بهترین گزینه‌ها برای تأمین امنیت سرمایه‌های دامی شماست. ما در <strong>بیمه‌یار</strong> با کد ۴۱۶۶۷۲، خدمات مشاوره تخصصی، <strong>بازدید از دامداری</strong> و <strong>صدور فوری</strong> را برای دامداران عزیز در <strong>قرچک، پیشوا، ورامین و پاکدشت</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
        <div class="trust-badges">
          <span class="badge">✅ نمایندگی رسمی بیمه سامان</span>
          <span class="badge">✅ کد نمایندگی: ۴۱۶۶۷۲</span>
          <span class="badge">✅ بیش از ۱۰ سال سابقه</span>
          <span class="badge">✅ همراهی در خسارت</span>
        </div>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">🐄</span>
          <h4>پوشش گاو</h4>
          <p>بیماری‌ها، تلفات و حوادث گاو شیری و گوشتی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🐑</span>
          <h4>پوشش گوسفند و بز</h4>
          <p>بیماری‌ها، تلفات و حوادث دام سبک</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🐔</span>
          <h4>پوشش طیور</h4>
          <p>مرغ، بوقلمون، شترمرغ و سایر طیور</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🐟</span>
          <h4>پوشش آبزیان</h4>
          <p>ماهی‌های گرمابی و سردآبی</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش اطلاعات دامداری‌های قرچک و پیشوا -->
  <div class="local-info-section">
    <h2 class="section-title">📊 <span class="highlight">دامداری قرچک و پیشوا</span> در یک نگاه</h2>
    <div class="local-info-grid">
      <div class="info-card">
        <span class="info-number">۲۰۰+</span>
        <p>واحد دامداری فعال</p>
      </div>
      <div class="info-card">
        <span class="info-number">۱۵۰٬۰۰۰+</span>
        <p>رأس دام سبک و سنگین</p>
      </div>
      <div class="info-card">
        <span class="info-number">۵۰۰+</span>
        <p>فرصت شغلی مستقیم</p>
      </div>
      <div class="info-card">
        <span class="info-number">۳۵%</span>
        <p>سهم شهرستان‌ها از تولید شیر استان</p>
      </div>
    </div>
    <p class="info-note">
      با توجه به اهمیت دامداری در اقتصاد منطقه، بیمه دام یک ضرورت اساسی برای تمامی دامداران است.
    </p>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه دامداران</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">💉</div>
        <h4>پوشش بیماری‌های واگیردار</h4>
        <p>تب برفکی، لمپی‌اسکین، طاعون نشخوارکنندگان، آبله، آنفلوانزای فوق‌حاد طیور و سایر بیماری‌های واگیردار تحت پوشش کامل قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📋</div>
        <h4>پوشش تلفات ناشی از بیماری</h4>
        <p>تلفات دام و طیور ناشی از بیماری‌های واگیردار و غیرواگیر تحت پوشش این بیمه قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>پوشش حوادث</h4>
        <p>تلفات ناشی از آتش‌سوزی، صاعقه، سیل، طوفان، برق‌گرفتگی و سایر حوادث تحت پوشش کامل قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🚑</div>
        <h4>پوشش هزینه‌های درمانی</h4>
        <p>هزینه‌های درمان دام و طیور، داروها و خدمات دامپزشکی تحت پوشش بیمه قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💰</div>
        <h4>جبران کاهش تولید</h4>
        <p>کاهش تولید شیر، گوشت و سایر فرآورده‌های دامی ناشی از بیماری و حوادث تحت پوشش قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>بازدید و کارشناسی سریع</h4>
        <p>کارشناسان ما در کمتر از ۲۴ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پرداخت خسارت در کوتاه‌ترین زمان ممکن انجام می‌شود.</p>
      </div>
    </div>
  </div>

  <!-- بخش انواع دام -->
  <div class="types-section">
    <h2 class="section-title">🐄 انواع <span class="highlight">دام و طیور</span> تحت پوشش</h2>
    <div class="types-grid">
      <div class="type-card">
        <span class="type-icon">🐄</span>
        <h4>گاو شیری و گوشتی</h4>
        <p>پوشش کامل گاوهای شیری، گوشتی و گوساله‌ها</p>
        <ul>
          <li>بیماری‌های واگیردار</li>
          <li>تلفات و حوادث</li>
          <li>کاهش تولید شیر</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🐑</span>
        <h4>گوسفند و بز</h4>
        <p>پوشش کامل گوسفند، بره، بز و بزغاله</p>
        <ul>
          <li>بیماری‌های واگیردار</li>
          <li>تلفات و حوادث</li>
          <li>کاهش تولید گوشت</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🐔</span>
        <h4>طیور</h4>
        <p>پوشش کامل مرغ، بوقلمون، شترمرغ، کبک و بلدرچین</p>
        <ul>
          <li>آنفلوانزای فوق‌حاد</li>
          <li>بیماری‌های تنفسی</li>
          <li>تلفات و حوادث</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🐟</span>
        <h4>آبزیان</h4>
        <p>پوشش کامل ماهی‌های گرمابی و سردآبی</p>
        <ul>
          <li>بیماری‌های ویروسی</li>
          <li>تلفات و حوادث</li>
          <li>کاهش تولید</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- بخش راهنمای بیماری‌های دام -->
  <div class="disease-section">
    <h2 class="section-title">⚠️ بیماری‌های <span class="highlight">رایج</span> دام در قرچک و پیشوا</h2>
    <div class="disease-grid">
      <div class="disease-item">
        <span class="disease-icon">🔥</span>
        <div>
          <h4>تب برفکی</h4>
          <p>یکی از خطرناک‌ترین بیماری‌های گاو و گوسفند که باعث کاهش شدید تولید شیر و تلفات می‌شود.</p>
        </div>
      </div>
      <div class="disease-item">
        <span class="disease-icon">🐛</span>
        <div>
          <h4>لمپی‌اسکین</h4>
          <p>بیماری ویروسی گاو که باعث ایجاد ضایعات پوستی، کاهش تولید و تلفات می‌شود.</p>
        </div>
      </div>
      <div class="disease-item">
        <span class="disease-icon">🦠</span>
        <div>
          <h4>طاعون نشخوارکنندگان</h4>
          <p>بیماری ویروسی خطرناک گوسفند و بز که تلفات بالا و کاهش تولید دارد.</p>
        </div>
      </div>
      <div class="disease-item">
        <span class="disease-icon">🐔</span>
        <div>
          <h4>آنفلوانزای فوق‌حاد طیور</h4>
          <p>بیماری ویروسی خطرناک طیور که باعث تلفات بالای مرغ و بوقلمون می‌شود.</p>
        </div>
      </div>
    </div>
    <p class="disease-note">
      بیمه دامداران سامان تمامی این بیماری‌ها را تحت پوشش قرار می‌دهد. برای اطلاع از جزئیات پوشش، با کارشناسان ما تماس بگیرید.
    </p>
  </div>

  <!-- بخش مراحل -->
  <div class="process-section">
    <h2 class="section-title">📋 مراحل <span class="highlight">ثبت‌نام</span> بیمه دام</h2>
    <div class="process-grid">
      <div class="process-item">
        <span class="process-number">۱</span>
        <h4>مشاوره رایگان</h4>
        <p>تماس با کارشناسان برای بررسی نیازهای دامداری شما</p>
      </div>
      <div class="process-item">
        <span class="process-number">۲</span>
        <h4>بازدید از دامداری</h4>
        <p>کارشناسان ما از دامداری شما بازدید کرده و ریسک‌ها را ارزیابی می‌کنند</p>
      </div>
      <div class="process-item">
        <span class="process-number">۳</span>
        <h4>تعیین پوشش و حق بیمه</h4>
        <p>انتخاب بهترین پوشش‌ها و محاسبه حق بیمه بر اساس تعداد دام</p>
      </div>
      <div class="process-item">
        <span class="process-number">۴</span>
        <h4>صدور بیمه‌نامه</h4>
        <p>صدور بیمه‌نامه پس از تأیید و پرداخت</p>
      </div>
    </div>
  </div>

  <!-- بخش FAQ -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> دامداران قرچک و پیشوا</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا بیمه دام، بیماری تب برفکی را پوشش می‌دهد؟</h4>
        <p>بله، بیمه دامداران سامان به طور کامل بیماری تب برفکی را پوشش می‌دهد. این بیماری یکی از مهم‌ترین بیماری‌های دام در منطقه است و خسارت‌های ناشی از آن تحت پوشش بیمه قرار می‌گیرد.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه دام، تلفات ناشی از آنفلوانزای فوق‌حاد طیور را پوشش می‌دهد؟</h4>
        <p>بله، بیمه دامداران سامان شامل پوشش تلفات ناشی از آنفلوانزای فوق‌حاد طیور می‌شود. این بیماری یکی از مهم‌ترین تهدیدات برای مرغداران است.</p>
      </div>
      <div class="faq-item">
        <h4>چگونه می‌توانم خسارت دام خود را ثبت کنم؟</h4>
        <p>برای ثبت خسارت، با کارشناسان ما تماس بگیرید. تیم کارشناسی ما در کمتر از ۲۴ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پس از تأیید، خسارت در کوتاه‌ترین زمان پرداخت می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>آیا می‌توانم بیمه دام را به صورت اقساطی خریداری کنم؟</h4>
        <p>بله، شما می‌توانید بیمه دام را به صورت نقدی یا اقساطی خریداری کنید. برای اطلاع از شرایط پرداخت، با کارشناسان ما تماس بگیرید.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🐄 با <span class="highlight-light">بیمه دامداران</span> سامان از سرمایه‌تان محافظت کنید</h2>
      <p>با ثبت‌نام در بیمه دامداران سامان، از پوشش کامل بیماری‌ها، تلفات، حوادث و کاهش تولید بهره‌مند شوید و خیال خود را از بابت خطرات دامداری راحت کنید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09025472929" class="cta-secondary">📱 تماس فوری: 09025472929</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #fcd34d;
    text-shadow: 0 2px 8px rgba(252,211,77,0.3);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #fcd34d;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-cta {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .hero-cta.primary {
    background: white;
    color: #065f46;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta.primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
