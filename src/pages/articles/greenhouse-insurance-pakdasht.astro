---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه گلخانه‌داران پاکدشت | بیمه گلخانه سامان (کد ۴۱۶۶۷۲) | علیرضا محمدی";
const description = "بیمه گلخانه‌داران پاکدشت با پوشش سازه، تجهیزات، محصولات و حوادث کارگران. مشاوره رایگان و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲) در پاکدشت و جنوب شرق تهران.";

// اسکیما مارک‌آپ پیشرفته برای بیمه گلخانه (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲) - پاکدشت",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه گلخانه‌داران در پاکدشت و جنوب شرق استان تهران.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "پاکدشت",
    "addressRegion": "تهران",
    "addressCountry": "IR"
  },
  "areaServed": [
    { "@type": "City", "name": "پاکدشت" },
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "بیمه گلخانه‌داران"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی",
    "identifier": "۴۱۶۶۷۲"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب محلی -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">🌱 ویژه گلخانه‌داران پاکدشت</span>
      <h1 class="hero-title">با <span class="highlight">بیمه گلخانه‌داران</span> سامان، از سرمایه‌تان محافظت کنید</h1>
      <p class="hero-desc">
        پوشش کامل سازه‌های گلخانه، تجهیزات، محصولات کشاورزی و حوادث کارگران در پاکدشت و جنوب شرق تهران. با مشاوره رایگان و هدیه نقدی ۲۰۰ هزار تومانی.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۲۰۰+</span>
          <span class="stat-label">گلخانه‌دار راضی در پاکدشت</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش سازه و تجهیزات</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۲۴h</span>
          <span class="stat-label">بازدید کارشناس در محل</span>
        </div>
      </div>
      <div class="hero-buttons">
        <a href="/#form" class="hero-cta primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="hero-cta secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🌱</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه گلخانه‌داران</span> در پاکدشت ضروری است؟</h2>
        <p>
          <strong>پاکدشت</strong> یکی از قطب‌های مهم تولید گل و گیاه زینتی، سبزیجات و صیفی‌جات در ایران است. گلخانه‌های پاکدشت با سرمایه‌گذاری‌های کلان، اشتغالزایی بالا و تولید محصولات باکیفیت، نقش مهمی در اقتصاد منطقه ایفا می‌کنند.
        </p>
        <p>
          با توجه به افزایش بلایای طبیعی مانند <strong>طوفان، تگرگ، سرمازدگی و آتش‌سوزی</strong>، بیمه گلخانه یک نیاز اساسی برای تمامی گلخانه‌داران پاکدشت است. <strong>بیمه گلخانه‌داران سامان</strong> با ارائه پوشش‌های کامل و تخصصی، یکی از بهترین گزینه‌ها برای تأمین امنیت سرمایه‌های شماست.
        </p>
        <p>
          ما در <strong>بیمه‌یار</strong> با کد ۴۱۶۶۷۲، خدمات مشاوره تخصصی، <strong>بازدید از گلخانه</strong> و <strong>صدور فوری</strong> را برای گلخانه‌داران عزیز در <strong>پاکدشت، ورامین، پیشوا و قرچک</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
        <div class="trust-badges">
          <span class="badge">✅ نمایندگی رسمی بیمه سامان</span>
          <span class="badge">✅ کد نمایندگی: ۴۱۶۶۷۲</span>
          <span class="badge">✅ بیش از ۱۰ سال سابقه</span>
          <span class="badge">✅ همراهی در خسارت</span>
        </div>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">🏗️</span>
          <h4>پوشش سازه گلخانه</h4>
          <p>سازه فلزی، پوشش پلاستیکی و شیشه‌ای</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">⚙️</span>
          <h4>پوشش تجهیزات</h4>
          <p>سیستم‌های گرمایشی، سرمایشی و آبیاری</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🌿</span>
          <h4>پوشش محصولات</h4>
          <p>گل‌های زینتی، سبزیجات و صیفی‌جات</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">👷</span>
          <h4>پوشش کارگران</h4>
          <p>حوادث ناشی از کار در گلخانه</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه گلخانه‌داران</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🏗️</div>
        <h4>پوشش کامل سازه گلخانه</h4>
        <p>سازه فلزی، پوشش پلاستیکی، شیشه‌ای و اسکلت اصلی گلخانه در برابر طوفان، تگرگ، آتش‌سوزی و بلایای طبیعی تحت پوشش قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚙️</div>
        <h4>پوشش تجهیزات و تأسیسات</h4>
        <p>سیستم‌های گرمایشی، سرمایشی، آبیاری، تهویه و برق‌رسانی گلخانه در برابر خرابی، آتش‌سوزی و سرقت پوشش داده می‌شوند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌿</div>
        <h4>پوشش محصولات گلخانه</h4>
        <p>گل‌های زینتی، گیاهان آپارتمانی، سبزیجات، صیفی‌جات و محصولات کشاورزی در برابر آفات، بیماری‌ها و بلایای طبیعی تحت پوشش قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👷</div>
        <h4>پوشش حوادث کارگران</h4>
        <p>کارگران گلخانه در برابر حوادث ناشی از کار، بیماری‌های شغلی و ازکارافتادگی تحت پوشش کامل این بیمه قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🚜</div>
        <h4>پوشش ماشین‌آلات کشاورزی</h4>
        <p>تراکتور، سمپاش، ماشین‌آلات خاک‌ورزی و سایر ادوات کشاورزی در برابر حوادث، سرقت و آتش‌سوزی پوشش داده می‌شوند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>بازدید و کارشناسی سریع</h4>
        <p>کارشناسان ما در کمتر از ۲۴ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پرداخت خسارت در کوتاه‌ترین زمان ممکن انجام می‌شود.</p>
      </div>
    </div>
  </div>

  <!-- بخش اطلاعات گلخانه‌های پاکدشت -->
  <div class="local-info-section">
    <h2 class="section-title">📊 <span class="highlight">گلخانه‌های پاکدشت</span> در یک نگاه</h2>
    <div class="local-info-grid">
      <div class="info-card">
        <span class="info-number">۵۰۰+</span>
        <p>گلخانه فعال در پاکدشت</p>
      </div>
      <div class="info-card">
        <span class="info-number">۳۰%</span>
        <p>تولید گل و گیاه زینتی کشور در پاکدشت</p>
      </div>
      <div class="info-card">
        <span class="info-number">۱۰۰۰+</span>
        <p>اشتغال مستقیم در بخش گلخانه‌داری</p>
      </div>
      <div class="info-card">
        <span class="info-number">۲۰۰۰+</span>
        <p>هکتار سطح زیر کشت گلخانه‌ای</p>
      </div>
    </div>
    <p class="info-note">
      با توجه به اهمیت و وسعت گلخانه‌داری در پاکدشت، داشتن بیمه‌نامه معتبر برای هر گلخانه‌دار یک ضرورت است.
    </p>
  </div>

  <!-- بخش انواع پوشش -->
  <div class="coverage-section">
    <h2 class="section-title">🛡️ پوشش‌های <span class="highlight">بیمه گلخانه‌داران</span> سامان</h2>
    <div class="coverage-grid">
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>سازه گلخانه</h4>
          <p>سازه فلزی، پوشش پلاستیکی، شیشه‌ای و اسکلت</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>تجهیزات و تأسیسات</h4>
          <p>سیستم‌های گرمایشی، سرمایشی، آبیاری و برق</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>محصولات کشاورزی</h4>
          <p>گل‌های زینتی، سبزیجات، صیفی‌جات و گیاهان</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>حوادث کارگران</h4>
          <p>حوادث ناشی از کار، بیماری‌های شغلی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>ماشین‌آلات کشاورزی</h4>
          <p>تراکتور، سمپاش و ادوات خاک‌ورزی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>مسئولیت مدنی</h4>
          <p>خسارت به اشخاص ثالث و همسایگان</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش نحوه ثبت‌نام -->
  <div class="process-section">
    <h2 class="section-title">📋 مراحل <span class="highlight">ثبت‌نام</span> بیمه گلخانه</h2>
    <div class="process-grid">
      <div class="process-item">
        <span class="process-number">۱</span>
        <h4>مشاوره رایگان</h4>
        <p>تماس با کارشناسان برای بررسی نیازهای گلخانه شما</p>
      </div>
      <div class="process-item">
        <span class="process-number">۲</span>
        <h4>بازدید از گلخانه</h4>
        <p>کارشناسان ما از گلخانه شما بازدید کرده و ریسک‌ها را ارزیابی می‌کنند</p>
      </div>
      <div class="process-item">
        <span class="process-number">۳</span>
        <h4>تعیین پوشش و حق بیمه</h4>
        <p>انتخاب بهترین پوشش‌ها و محاسبه حق بیمه</p>
      </div>
      <div class="process-item">
        <span class="process-number">۴</span>
        <h4>صدور بیمه‌نامه</h4>
        <p>صدور بیمه‌نامه پس از تأیید و پرداخت</p>
      </div>
    </div>
  </div>

  <!-- بخش سوالات متداول -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> گلخانه‌داران پاکدشت</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا بیمه گلخانه، خسارت ناشی از طوفان را پوشش می‌دهد؟</h4>
        <p>بله، بیمه گلخانه‌داران سامان به طور کامل خسارت‌های ناشی از طوفان، تگرگ، سرمازدگی، آتش‌سوزی و سایر بلایای طبیعی را پوشش می‌دهد. این پوشش شامل سازه، تجهیزات و محصولات گلخانه می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه گلخانه، هزینه‌های ناشی از آفات و بیماری‌ها را پوشش می‌دهد؟</h4>
        <p>بله، بیمه گلخانه‌داران سامان شامل پوشش خسارت‌های ناشی از آفات گیاهی، بیماری‌های قارچی، ویروسی و باکتریایی می‌شود. برای اطلاع از جزئیات پوشش، با کارشناسان ما تماس بگیرید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا می‌توانم بیمه گلخانه را به صورت اقساطی خریداری کنم؟</h4>
        <p>بله، شما می‌توانید بیمه گلخانه را به صورت نقدی یا اقساطی خریداری کنید. برای اطلاع از شرایط پرداخت، با کارشناسان ما تماس بگیرید.</p>
      </div>
      <div class="faq-item">
        <h4>چگونه می‌توانم خسارت گلخانه خود را ثبت کنم؟</h4>
        <p>برای ثبت خسارت، با کارشناسان ما تماس بگیرید. تیم کارشناسی ما در کمتر از ۲۴ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند. پس از تأیید، خسارت در کوتاه‌ترین زمان پرداخت می‌شود.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🌱 با <span class="highlight-light">بیمه گلخانه‌داران</span> سامان از سرمایه‌تان محافظت کنید</h2>
      <p>با ثبت‌نام در بیمه گلخانه‌داران سامان، از پوشش کامل سازه، تجهیزات، محصولات و حوادث کارگران بهره‌مند شوید و خیال خود را از بابت بلایای طبیعی و حوادث راحت کنید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09025472929" class="cta-secondary">📱 تماس فوری: 09025472929</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #065f46 0%, #059669 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #fcd34d;
    text-shadow: 0 2px 8px rgba(252,211,77,0.3);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #fcd34d;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-cta {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .hero-cta.primary {
    background: white;
    color: #065f46;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta.primary:hover {
    transform: translateY(-3px);
