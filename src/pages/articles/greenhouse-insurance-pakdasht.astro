    color: white;
    border: 2px solid rgba(255,255,255,0.3);
  }
  .hero-cta.secondary:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-3px);
  }
  .hero-image {
    flex: 0 0 120px;
    text-align: center;
  }
  .hero-icon {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== بخش معرفی ===== */
  .intro-section {
    margin: 40px 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .intro-text h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .intro-text .highlight {
    color: #065f46;
    font-weight: 700;
  }
  .intro-text p {
    line-height: 1.8;
    color: #333;
    margin-bottom: 12px;
  }
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
