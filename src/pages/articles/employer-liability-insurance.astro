---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه مسئولیت کارفرما در قبال کارکنان در ورامین، پاکدشت، پیشوا و قرچک | بیمه کارگران";
const description = "خرید بیمه کارفرما و مسئولیت کارکنان سامان با پوشش حوادث کاری، درمانی و جبران خسارت در ورامین، پیشوا، قرچک و پاکدشت. مشاوره و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// اسکیما مارک‌آپ پیشرفته برای بیمه کارفرما (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه مسئولیت کارفرما در قبال کارکنان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور و مشاوره بیمه مسئولیت کارفرما"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">⚖️ ویژه کارفرمایان و صاحبان کسب‌وکار</span>
      <h1 class="hero-title">با <span class="highlight">بیمه مسئولیت کارفرما</span> سامان، از کارکنان خود محافظت کنید</h1>
      <p class="hero-desc">
        پوشش کامل حوادث کاری، درمانی و جبران خسارت برای کارکنان در محیط کار. طبق قانون کار، خرید این بیمه برای تمام کارفرمایان الزامی است.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش حوادث کاری</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۲۴/۷</span>
          <span class="stat-label">پشتیبانی خسارت</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۱۲۰+</span>
          <span class="stat-label">صنعت تحت پوشش</span>
        </div>
      </div>
      <a href="/#form" class="hero-cta">📞 دریافت مشاوره رایگان</a>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🏢</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه مسئولیت کارفرما</span> ضروری است؟</h2>
        <p>
          <strong>بیمه مسئولیت کارفرما در قبال کارکنان</strong> یکی از الزامات قانون کار در ایران است. بر اساس این قانون، تمامی کارفرمایان موظف هستند در برابر حوادث ناشی از کار که برای کارکنان رخ می‌دهد، مسئولیت داشته باشند و خسارت‌های وارده را جبران کنند.
        </p>
        <p>
          <strong>بیمه مسئولیت کارفرما سامان</strong> با ارائه پوشش‌های کامل درمانی، جبرانی و حقوقی، یکی از بهترین گزینه‌ها برای کارفرمایان در صنایع مختلف است. ما در <strong>بیمه‌یار</strong>، خدمات مشاوره تخصصی، <strong>بررسی ریسک‌ها</strong> و <strong>صدور فوری</strong> را برای کارفرمایان عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">🏥</span>
          <h4>پوشش درمانی</h4>
          <p>هزینه‌های درمانی کارکنان در حوادث کاری</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">💰</span>
          <h4>جبران خسارت</h4>
          <p>پرداخت غرامت و دیه در صورت فوت یا ازکارافتادگی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">⚖️</span>
          <h4>پوشش حقوقی</h4>
          <p>هزینه‌های دادرسی و وکالت در دعاوی حقوقی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🛡️</span>
          <h4>آرامش خاطر</h4>
          <p>عدم نگرانی از هزینه‌های سنگین حوادث کاری</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه مسئولیت کارفرما</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🏥</div>
        <h4>پوشش کامل درمانی</h4>
        <p>هزینه‌های بستری، جراحی، دارو، فیزیوتراپی و توانبخشی کارکنان در حوادث کاری تحت پوشش این بیمه قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💰</div>
        <h4>جبران خسارت و دیه</h4>
        <p>در صورت فوت یا ازکارافتادگی کامل یا جزئی کارکنان، غرامت و دیه به آنان یا بازماندگانشان پرداخت می‌شود.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚖️</div>
        <h4>پوشش هزینه‌های حقوقی</h4>
        <p>هزینه‌های دادرسی، وکالت و مشاوره حقوقی در صورت طرح دعوی توسط کارکنان تحت پوشش قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🛡️</div>
        <h4>پوشش بیماری‌های شغلی</h4>
        <p>بیماری‌های ناشی از کار مانند بیماری‌های تنفسی، شنوایی، پوستی و ... تحت پوشش این بیمه هستند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📋</div>
        <h4>انطباق با قانون کار</h4>
        <p>این بیمه‌نامه مطابق با ماده ۱۲ قانون کار و الزامات سازمان تأمین اجتماعی طراحی شده است.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>صدور فوری و آنلاین</h4>
        <p>امکان استعلام و صدور بیمه‌نامه در کمترین زمان ممکن بدون نیاز به بازدید.</p>
      </div>
    </div>
  </div>

  <!-- بخش انواع کسب‌وکار -->
  <div class="business-section">
    <h2 class="section-title">🏢 چه <span class="highlight">کسب‌وکارهایی</span> به بیمه کارفرما نیاز دارند؟</h2>
    <div class="business-grid">
      <div class="business-card">
        <span class="business-icon">🏗️</span>
        <h4>صنایع ساختمانی</h4>
        <p>کارگاه‌های ساختمانی، پیمانکاران، مهندسان ناظر و ...</p>
        <span class="business-tag">ریسک بالا</span>
      </div>
      <div class="business-card">
        <span class="business-icon">🏭</span>
        <h4>صنایع تولیدی</h4>
        <p>کارخانه‌ها، واحدهای تولیدی، ماشین‌آلات و خطوط تولید</p>
        <span class="business-tag">ریسک متوسط</span>
      </div>
      <div class="business-card">
        <span class="business-icon">🏪</span>
        <h4>واحدهای تجاری</h4>
        <p>مغازه‌ها، فروشگاه‌ها، سوپرمارکت‌ها و مراکز خرید</p>
        <span class="business-tag">ریسک پایین</span>
      </div>
      <div class="business-card">
        <span class="business-icon">🚛</span>
        <h4>حمل‌ونقل و لجستیک</h4>
        <p>شرکت‌های حمل‌ونقل، رانندگان، انبارداری و توزیع</p>
        <span class="business-tag">ریسک متوسط</span>
      </div>
      <div class="business-card">
        <span class="business-icon">⚡</span>
        <h4>صنایع انرژی</h4>
        <p>نیروگاه‌ها، پالایشگاه‌ها، صنایع نفت و گاز</p>
        <span class="business-tag">ریسک بسیار بالا</span>
      </div>
      <div class="business-card">
        <span class="business-icon">🖥️</span>
        <h4>شرکت‌های دانش‌بنیان</h4>
        <p>دفاتر فنی، مهندسی، مشاوره، فناوری اطلاعات</p>
        <span class="business-tag">ریسک پایین</span>
      </div>
    </div>
  </div>

  <!-- بخش پوشش‌ها -->
  <div class="coverage-section">
    <h2 class="section-title">🛡️ پوشش‌های <span class="highlight">بیمه مسئولیت کارفرما</span> سامان</h2>
    <div class="coverage-grid">
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>هزینه‌های درمانی</h4>
          <p>بستری، جراحی، دارو، آزمایش و فیزیوتراپی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>غرامت ازکارافتادگی</h4>
          <p>پرداخت غرامت در صورت ازکارافتادگی کامل یا جزئی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>دیه فوت</h4>
          <p>پرداخت دیه به بازماندگان در صورت فوت کارکنان</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>بیماری‌های شغلی</h4>
          <p>بیماری‌های ناشی از کار مانند تنفسی، شنوایی، پوستی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>هزینه‌های حقوقی</h4>
          <p>دادرسی، وکالت و مشاوره حقوقی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>هزینه‌های انتقال</h4>
          <p>انتقال کارکنان مصدوم به بیمارستان یا منزل</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مدارک و مراحل -->
  <div class="process-section">
    <h2 class="section-title">📋 مراحل <span class="highlight">ثبت‌نام</span> بیمه کارفرما</h2>
    <div class="process-grid">
      <div class="process-item">
        <span class="process-number">۱</span>
        <h4>مشاوره رایگان</h4>
        <p>تماس با کارشناسان برای بررسی نیازها و ریسک‌های کسب‌وکار</p>
      </div>
      <div class="process-item">
        <span class="process-number">۲</span>
        <h4>تکمیل فرم ثبت‌نام</h4>
        <p>ارائه اطلاعات کارکنان، نوع فعالیت و سابقه کاری</p>
      </div>
      <div class="process-item">
        <span class="process-number">۳</span>
        <h4>بررسی ریسک</h4>
        <p>ارزیابی ریسک‌های محیط کار و تعیین حق بیمه</p>
      </div>
      <div class="process-item">
        <span class="process-number">۴</span>
        <h4>صدور بیمه‌نامه</h4>
        <p>صدور بیمه‌نامه پس از تأیید و پرداخت</p>
      </div>
    </div>
  </div>

  <!-- بخش FAQ -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> کارفرمایان</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا بیمه مسئولیت کارفرما برای تمام کسب‌وکارها الزامی است؟</h4>
        <p>بله، طبق ماده ۱۲ قانون کار، تمامی کارفرمایان موظف هستند نسبت به خرید بیمه مسئولیت کارفرما در قبال کارکنان خود اقدام کنند. عدم خرید این بیمه، جریمه و مسئولیت حقوقی برای کارفرما به همراه دارد.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه کارفرما، کارکنان پیمانکاری را نیز پوشش می‌دهد؟</h4>
        <p>بله، در صورتی که کارکنان پیمانکاری تحت نظارت و مدیریت کارفرما فعالیت کنند، تحت پوشش بیمه مسئولیت کارفرما قرار می‌گیرند. برای اطلاع از جزئیات، با کارشناسان ما تماس بگیرید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه کارفرما، هزینه‌های ناشی از بیماری‌های شغلی را پوشش می‌دهد؟</h4>
        <p>بله، بیمه مسئولیت کارفرما سامان شامل پوشش بیماری‌های ناشی از کار مانند بیماری‌های تنفسی، شنوایی، پوستی و ... می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>حق بیمه کارفرما چگونه محاسبه می‌شود؟</h4>
        <p>حق بیمه بر اساس نوع فعالیت، تعداد کارکنان، سابقه کاری و میزان ریسک محیط کار محاسبه می‌شود. برای استعلام دقیق قیمت، با کارشناسان ما تماس بگیرید.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>⚖️ با <span class="highlight-light">بیمه مسئولیت کارفرما</span> از کارکنان خود محافظت کنید</h2>
      <p>با ثبت‌نام در بیمه مسئولیت کارفرما سامان، از پوشش کامل درمانی، جبرانی و حقوقی برای کارکنان خود بهره‌مند شوید و خیال خود را از بابت حوادث کاری راحت کنید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09025472929" class="cta-secondary">📱 تماس فوری: 09025472929</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.12);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #facc15;
    text-shadow: 0 2px 8px rgba(250,204,21,0.25);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #facc15;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-cta {
    display: inline-block;
    background: white;
    color: #0f172a;
    padding: 14px 32px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
  .hero-image {
    flex: 0 0 120px;
    text-align: center;
  }
  .hero-icon {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== بخش معرفی ===== */
  .intro-section {
    margin: 40px 0;
  }
