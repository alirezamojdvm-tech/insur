---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی محلی برای سئو
const title = "پیگیری و دریافت خسارت بیمه سامان در ورامین، پاکدشت، پیشوا و قرچک";
const description = "تا دریافت کامل خسارت بیمه سامان همراه شما هستیم. مشاوره و پیگیری پرونده خسارت در ورامین، پیشوا، قرچک و پاکدشت با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// کدهای اسکیما (Schema Markup) برای سئوی محلی
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "description": "خدمات مشاوره و پیگیری تخصصی خسارت بیمه سامان در شهرهای ورامین، پیشوا، قرچک و پاکدشت.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  {/* تزریق کد اسکیما برای شناسایی موقعیت توسط گوگل */}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <p>
    یکی از دغدغه‌های اصلی بیمه‌گذاران، فرآیند پیچیده و زمان‌بر <strong>دریافت خسارت</strong> است. بسیاری از افراد پس از خرید بیمه‌نامه، در زمان حادثه سردرگم می‌شوند و نمی‌دانند چگونه باید خسارت خود را دریافت کنند.
  </p>

  <h2>ما این مشکل را در منطقه شما حل کرده‌ایم</h2>
  <p>
    در <strong>بیمه‌یار</strong>، خدمات ویژه پیگیری خسارت را به همشهریان عزیز در <strong>ورامین، پیشوا، قرچک و پاکدشت</strong> ارائه می‌دهیم. تعهد ما تنها به فروش بیمه‌نامه ختم نمی‌شود. ما تا <strong>دریافت کامل خسارت</strong> در کنار شما هستیم و تمام مراحل زیر را برای شما مدیریت می‌کنیم:
  </p>

  <ul>
    <li><strong>🔹 مشاوره‌ی اولیه پس از حادثه:</strong> به شما می‌گوییم چه مدارکی نیاز دارید و چگونه خسارت را گزارش دهید.</li>
    <li><strong>🔹 راهنمایی در تکمیل فرم‌ها:</strong> تمام فرم‌های مربوط به خسارت را با شما مرور می‌کنیم تا هیچ نکته‌ای از قلم نیفتد.</li>
    <li><strong>🔹 پیگیری پرونده در شرکت بیمه:</strong> به‌جای شما با کارشناسان بیمه سامان مکاتبه و پیگیری می‌کنیم تا روند خسارت تسریع شود.</li>
    <li><strong>🔹 مشاوره در مورد مبلغ خسارت:</strong> اگر مبلغ اعلام‌شده توسط بیمه‌گر کمتر از حد انتظار بود، ما به شما کمک می‌کنیم تا اعتراض خود را به‌درستی ثبت کنید.</li>
  </ul>

  <h2>نتیجه</h2>
  <p>
    شما بدون هیچ استرسی، خسارت خود را به‌طور کامل و در سریع‌ترین زمان ممکن دریافت می‌کنید.
  </p>

  <div class="highlight-box">
    <strong>🤝 با انتخاب <strong>علیرضا محمدی (کد ۴۱۶۶۷۲)</strong> به‌عنوان مشاور بیمه‌ی خود، نه‌تنها از خدمات مشاوره‌ی رایگان بهره‌مند می‌شوید، بلکه یک همراه حرفه‌ای در مسیر دریافت خسارت خواهید داشت.</strong>
  </div>

  <div class="cta-box">
    <h3>🤝 نیاز به همراهی در خسارت دارید؟</h3>
    <p>همین حالا فرم مشاوره را پر کنید تا ما از ابتدا تا انتها همراه شما باشیم.</p>
    <a href="/#form" class="cta-button">دریافت مشاوره رایگان</a>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>
