// اسکیما مارک‌آپ پیشرفته برای بیمه آتش‌سوزی و باربری (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
