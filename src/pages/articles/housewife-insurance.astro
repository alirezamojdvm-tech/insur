    background: white;
    padding: 28px 24px;
    border-radius: 20px;
    text-align: center;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }
  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(37,99,235,0.12);
    border-color: #2563eb;
  }
  .feature-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 12px;
  }
  .feature-card h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: #1e3a8a;
  }
  .feature-card p {
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0;
  }

  /* ===== بخش شرایط ===== */
  .conditions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }
  .condition-card {
    background: #f8fafc;
    padding: 24px 20px;
    border-radius: 16px;
    text-align: center;
    border-right: 4px solid #2563eb;
    transition: all 0.3s ease;
  }
  .condition-card:hover {
    background: white;
    box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    transform: translateX(4px);
  }
  .condition-number {
    display: inline-block;
    font-size: 1.8rem;
    font-weight: 800;
    color: #2563eb;
    opacity: 0.3;
    margin-bottom: 4px;
  }
  .condition-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 6px;
    color: #1e3a8a;
  }
  .condition-card p {
    font-size: 0.9rem;
    color: #4b5563;
    margin: 0;
  }

  /* ===== بخش مراحل ===== */
  .steps-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 700px;
    margin: 0 auto;
  }
  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background: white;
    padding: 20px 24px;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }
  .step-item:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.06);
    border-color: #2563eb;
  }
  .step-number {
    flex: 0 0 44px;
    height: 44px;
    background: #1e3a8a;
    color: white;
    font-size: 1.2rem;
    font-weight: 800;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-content h4 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 4px;
    color: #1e3a8a;
  }
  .step-content p {
    font-size: 0.95rem;
    color: #4b5563;
    margin: 0;
