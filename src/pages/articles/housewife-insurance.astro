---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه زنان خانه‌دار سامان در ورامین، پاکدشت، پیشوا و قرچک | تأمین اجتماعی و بازنشستگی";
const description = "خرید بیمه زنان خانه‌دار سامان با پوشش تأمین اجتماعی، بازنشستگی و خدمات درمانی در ورامین، پیشوا، قرچک و پاکدشت. مشاوره و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// اسکیما مارک‌آپ پیشرفته برای بیمه زنان خانه‌دار (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه زنان خانه‌دار سامان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور و مشاوره بیمه زنان خانه‌دار"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">ویژه زنان خانه‌دار</span>
      <h1 class="hero-title">آینده‌تان را با <span class="highlight">بیمه زنان خانه‌دار</span> سامان تضمین کنید</h1>
      <p class="hero-desc">
        تأمین اجتماعی، بازنشستگی و خدمات درمانی کامل برای زنانی که به‌دلیل خانه‌داری، از پوشش بیمه‌ای محروم مانده‌اند.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۲۰+</span>
          <span class="stat-label">سال پوشش تا بازنشستگی</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش درمانی کامل</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۷۰%</span>
          <span class="stat-label">تخفیف ویژه ثبت‌نام</span>
        </div>
      </div>
      <a href="/#form" class="hero-cta">📞 دریافت مشاوره رایگان</a>
    </div>
    <div class="hero-image">
      <div class="hero-icon">👩‍👧‍👦</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه زنان خانه‌دار</span>؟</h2>
        <p>
          <strong>بیمه زنان خانه‌دار</strong> یکی از مهم‌ترین بیمه‌نامه‌هایی است که می‌تواند امنیت مالی و آینده شغلی زنان خانه‌دار را تأمین کند. بسیاری از زنان خانه‌دار به دلیل عدم اشتغال رسمی، از پوشش بیمه تأمین اجتماعی و بازنشستگی محروم هستند. این بیمه‌نامه دقیقاً برای رفع این نیاز طراحی شده است.
        </p>
        <p>
          <strong>بیمه زنان خانه‌دار سامان</strong> با ارائه پوشش‌های کامل و رقابتی، یکی از بهترین گزینه‌ها برای تأمین امنیت مالی و درمانی زنان خانه‌دار است. ما در <strong>بیمه‌یار</strong>، خدمات مشاوره تخصصی، <strong>بررسی شرایط</strong> و <strong>صدور فوری</strong> را برای همشهریان عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">🏦</span>
          <h4>بازنشستگی مطمئن</h4>
          <p>پس از ۲۰ سال، مستمری بازنشستگی دریافت کنید</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🏥</span>
          <h4>درمان کامل</h4>
          <p>پوشش بستری، سرپایی و پاراکلینیک</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🛡️</span>
          <h4>ازکارافتادگی</h4>
          <p>پوشش کامل در صورت ازکارافتادگی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">👨‍👩‍👧‍👦</span>
          <h4>بازماندگان</h4>
          <p>مستمری برای وراث در صورت فوت</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه زنان خانه‌دار</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">💰</div>
        <h4>مستمری بازنشستگی</h4>
        <p>پس از ۲۰ سال پرداخت حق بیمه، مستمری ماهانه دریافت می‌کنید که می‌تواند آینده مالی شما را تضمین کند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🏥</div>
        <h4>پوشش کامل درمانی</h4>
        <p>خدمات بستری، سرپایی، پاراکلینیک، دندانپزشکی و خدمات تخصصی دیگر تحت پوشش این بیمه قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🛡️</div>
        <h4>پوشش ازکارافتادگی</h4>
        <p>در صورت ازکارافتادگی کامل یا جزئی ناشی از حادثه یا بیماری، مستمری ماهانه به شما پرداخت می‌شود.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👨‍👩‍👧‍👦</div>
        <h4>پوشش بازماندگان</h4>
        <p>در صورت فوت، به وراث شما مستمری پرداخت می‌شود تا خانواده‌تان با مشکل مالی مواجه نشوند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📈</div>
        <h4>سرمایه‌گذاری بلندمدت</h4>
        <p>امکان استفاده از بیمه به عنوان وثیقه برای دریافت وام از بانک‌ها و مؤسسات مالی.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>صدور فوری</h4>
        <p>ثبت‌نام و صدور بیمه‌نامه در کمترین زمان ممکن بدون نیاز به معاینه پزشکی برای مبالغ پایین.</p>
      </div>
    </div>
  </div>

  <!-- بخش شرایط -->
  <div class="conditions-section">
    <h2 class="section-title">📋 شرایط <span class="highlight">ثبت‌نام</span> بیمه زنان خانه‌دار</h2>
    <div class="conditions-grid">
      <div class="condition-card">
        <span class="condition-number">۰۱</span>
        <h4>سن</h4>
        <p>بین ۱۸ تا ۵۰ سال (در برخی موارد تا ۵۵ سال نیز امکان‌پذیر است)</p>
      </div>
      <div class="condition-card">
        <span class="condition-number">۰۲</span>
        <h4>تابعیت</h4>
        <p>دارای تابعیت ایرانی</p>
      </div>
      <div class="condition-card">
        <span class="condition-number">۰۳</span>
        <h4>وضعیت تأهل</h4>
        <p>متأهل یا مجرد (با شرایط خاص)</p>
      </div>
      <div class="condition-card">
        <span class="condition-number">۰۴</span>
        <h4>عدم اشتغال</h4>
        <p>نباید شاغل رسمی و تحت پوشش بیمه تأمین اجتماعی باشید</p>
      </div>
    </div>
  </div>

  <!-- بخش نحوه ثبت‌نام -->
  <div class="steps-section">
    <h2 class="section-title">🚀 نحوه <span class="highlight">ثبت‌نام</span> بیمه زنان خانه‌دار</h2>
    <div class="steps-timeline">
      <div class="step-item">
        <div class="step-number">۱</div>
        <div class="step-content">
          <h4>مشاوره رایگان</h4>
          <p>با کارشناسان ما تماس بگیرید تا شرایط و مزایای بیمه را برای شما توضیح دهند.</p>
        </div>
      </div>
      <div class="step-item">
        <div class="step-number">۲</div>
        <div class="step-content">
          <h4>تکمیل فرم ثبت‌نام</h4>
          <p>فرم ثبت‌نام را تکمیل کنید و مدارک مورد نیاز را ارائه دهید.</p>
        </div>
      </div>
      <div class="step-item">
        <div class="step-number">۳</div>
        <div class="step-content">
          <h4>پرداخت حق بیمه</h4>
          <p>حق بیمه را به صورت ماهانه، سهماهه، ششماهه یا سالانه پرداخت کنید.</p>
        </div>
      </div>
      <div class="step-item">
        <div class="step-number">۴</div>
        <div class="step-content">
          <h4>صدور بیمه‌نامه</h4>
          <p>پس از ثبت‌نام و پرداخت، بیمه‌نامه شما صادر می‌شود.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش FAQ -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span></h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا زنان مجرد نیز می‌توانند از بیمه زنان خانه‌دار استفاده کنند؟</h4>
        <p>بله، زنان مجرد نیز تحت شرایط خاص می‌توانند از این بیمه‌نامه استفاده کنند. برای اطلاع از جزئیات، با کارشناسان ما تماس بگیرید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه زنان خانه‌دار، هزینه‌های بارداری و زایمان را پوشش می‌دهد؟</h4>
        <p>بله، بیمه زنان خانه‌دار سامان شامل پوشش هزینه‌های بارداری، زایمان طبیعی و سزارین می‌شود. برای اطلاع از جزئیات پوشش، با کارشناسان ما مشورت کنید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا می‌توانم حق بیمه را به صورت اقساطی پرداخت کنم؟</h4>
        <p>بله، شما می‌توانید حق بیمه را به صورت ماهانه، سهماهه، ششماهه یا سالانه پرداخت کنید. این انعطاف‌پذیری به شما کمک می‌کند تا پرداخت‌ها را با بودجه خود هماهنگ کنید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه زنان خانه‌دار، پوشش ازکارافتادگی دارد؟</h4>
        <p>بله، بیمه زنان خانه‌دار شامل پوشش ازکارافتادگی کامل و جزئی ناشی از حادثه یا بیماری می‌شود. در صورت ازکارافتادگی، مستمری ماهانه به شما پرداخت می‌شود.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🛡️ آینده خود را <span class="highlight-light">همین امروز</span> تضمین کنید</h2>
      <p>با ثبت‌نام در بیمه زنان خانه‌دار سامان، از مزایای بازنشستگی، درمان و ازکارافتادگی بهره‌مند شوید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="cta-secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #fbbf24;
    text-shadow: 0 2px 8px rgba(251,191,36,0.3);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #fbbf24;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-cta {
    display: inline-block;
    background: white;
    color: #1e3a8a;
    padding: 14px 32px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
  .hero-image {
    flex: 0 0 120px;
    text-align: center;
  }
  .hero-icon {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== بخش معرفی ===== */
  .intro-section {
    margin: 40px 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .intro-text h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .intro-text p {
    line-height: 1.8;
    color: #333;
    margin-bottom: 12px;
  }
  .intro-text .highlight {
    color: #1e3a8a;
    font-weight: 700;
  }
  .intro-benefits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .benefit-card {
    background: #f8fafc;
    padding: 20px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }
  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    border-color: #2563eb;
  }
  .benefit-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 8px;
  }
  .benefit-card h4 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 4px;
    color: #1e3a8a;
  }
  .benefit-card p {
    font-size: 0.85rem;
    color: #4b5563;
    margin: 0;
  }

  /* ===== بخش مزایا ===== */
  .features-section, .conditions-section, .steps-section, .faq-section {
    margin: 50px 0;
  }
  .section-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 30px;
  }
