---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی (هوشمندانه‌تر، روان‌تر و بدون تکرار غیرطبیعی)
const title = "بیمه شخص ثالث سامان ورامین، پاکدشت، پیشوا و قرچک | صدور فوری";
const description = "خرید و تمدید بیمه شخص ثالث سامان با پوشش جامع و قیمت مناسب در ورامین، پیشوا، قرچک و پاکدشت. ثبت‌نام توسط علیرضا محمدی (کد ۴۱۶۶۷۲) با هدیه ۲۰۰ هزار تومانی.";

// اسکیما مارک‌آپ پیشرفته با معرفی دقیق نوع خدمات (Service) و اتصال به دامنه اصلی سایت
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و تمدید آنلاین و حضوری بیمه شخص ثالث سامان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور بیمه شخص ثالث خودرو و موتورسیکلت"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  {/* تزریق اسکیمای پیشرفته به هدر */}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <p>
    <strong>بیمه شخص ثالث</strong> یکی از ضروری‌ترین بیمه‌نامه‌ها برای تمام رانندگان خودرو در ایران است. این بیمه‌نامه نه‌تنها یک الزام قانونی است، بلکه آرامش خاطر شما را در جاده‌های پرتردد تضمین می‌کند.
  </p>

  <p>
    <strong>بیمه شخص ثالث سامان</strong> با پوشش‌های متنوع و پاسخ‌گویی سریع، یکی از معتبرترین گزینه‌ها در بازار بیمه است. ما در <strong>بیمه‌یار</strong> فرآیند صدور و تمدید این بیمه‌نامه را برای همشهریان خود در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به ساده‌ترین شکل ممکن فراهم کرده‌ایم.
  </p>

  <h2>چرا صدور بیمه از نمایندگی محلی شما؟</h2>
  <p>
    خرید بیمه از یک نمایندگی فعال در منطقه شما (جنوب شرق استان تهران) این مزیت بزرگ را دارد که در زمان بروز حادثه یا نیاز به الحاقیه، دسترسی مستقیم و سریع‌تری به مشاور خود خواهید داشت. خدمات ما برای شما شامل موارد زیر است:
  </p>

  <ul>
    <li><strong>🚗 پوشش کامل خسارات جانی و مالی:</strong> جبران هزینه‌های اشخاص ثالث در حوادث رانندگی بدون نگرانی و با بالاترین سقف تعهدات.</li>
    <li><strong>⚡ صدور و تمدید فوری در منطقه:</strong> بدون نیاز به مراجعه حضوری در ترافیک، بیمه‌نامه شما در شهرهای ورامین، قرچک، پیشوا و پاکدشت به‌صورت آنلاین صادر می‌شود.</li>
    <li><strong>💰 حفظ تخفیف‌ها و قیمت رقابتی:</strong> اعمال کامل تخفیف‌های عدم خسارت (تا ۷۰٪) و ارائه مناسب‌ترین نرخ حق‌بیمه.</li>
    <li><strong>📞 پشتیبانی واقعی و در دسترس:</strong> ارتباط مستقیم با علیرضا محمدی (کد ۴۱۶۶۷۲) برای دریافت مشاوره در زمان تصادفات.</li>
    <li><strong>🎁 هدیه‌ی ۲۰۰ هزار تومانی:</strong> مزیت ویژه برای بیمه‌گذارانی که از طریق سایت ثبت‌نام می‌کنند.</li>
  </ul>

  <h2>چه کسانی به بیمه شخص ثالث نیاز دارند؟</h2>
  <p>
    تمامی دارندگان خودروهای سواری، باری، تاکسی‌ها و موتورسیکلت‌ها. تردد بدون بیمه‌نامه معتبر علاوه بر جریمه‌های سنگین پلیس راهور، ریسک جبران خسارت‌های میلیاردی را به همراه دارد.
  </p>

  <div class="highlight-box">
    <strong>🚗 زمان تمدید بیمه‌نامه فرا رسیده؟</strong> فرم مشاوره را پر کنید تا <strong>علیرضا محمدی</strong> بهترین پیشنهاد بیمه شخص ثالث سامان را به شما ارائه دهد و از <strong>هدیه ۲۰۰ هزار تومانی</strong> بهره‌مند شوید.
  </div>

  <div class="cta-box">
    <h3>🚗 استعلام قیمت بیمه شخص ثالث سامان</h3>
    <p>برای دریافت مشاوره و اطلاع از قیمت دقیق، همین حالا اقدام کنید.</p>
    <a href="/#form" class="cta-button">دریافت مشاوره رایگان</a>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>