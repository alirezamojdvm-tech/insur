---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه تکمیل درمان سامان در ورامین، پاکدشت، پیشوا و قرچک | انفرادی و خانواده";
const description = "خرید بیمه تکمیل درمان سامان با پوشش کامل هزینه‌های بیمارستانی، جراحی و دارو در ورامین، پیشوا، قرچک و پاکدشت. مشاوره با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// اسکیما مارک‌آپ پیشرفته برای بیمه درمان (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "مشاوره و صدور انواع بیمه تکمیل درمان انفرادی و خانواده سامان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور بیمه تکمیل درمان انفرادی و خانواده"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  {/* تزریق کدهای اسکیما برای شناسایی خدمات محلی توسط گوگل */}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <p>
    با افزایش چشمگیر هزینه‌های درمان، دارو و خدمات بیمارستانی و همچنین محدودیت‌های پوشش بیمه‌های پایه، داشتن یک <strong>بیمه‌ی تکمیل درمان</strong> معتبر هوشمندانه‌ترین تصمیمی است که می‌توانید برای حفظ سلامت و آرامش خود و خانواده‌تان بگیرید.
  </p>

  <p>
    <strong>بیمه تکمیل درمان سامان</strong> با ارائه طرح‌های متنوع انفرادی و خانواده، هزینه‌های سنگین درمانی را به‌طور چشمگیری کاهش می‌دهد. ما در <strong>بیمه‌یار</strong>، خدمات مشاوره و انتخاب بهترین طرح درمانی را به صورت تخصصی برای همشهریان عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> ارائه می‌دهیم.
  </p>

  <h2>پوشش‌های اصلی بیمه تکمیل درمان سامان</h2>
  <ul>
    <li><strong>🏥 هزینه‌های بستری و جراحی:</strong> پوشش کامل هزینه‌های اتاق عمل، پزشک، بیهوشی، جراحی‌های تخصصی و عمومی در بیمارستان‌ها.</li>
    <li><strong>👨‍⚕️ ویزیت پزشکان و دارو:</strong> جبران بخشی از هزینه‌های ویزیت پزشکان متخصص و داروهای تجویزی.</li>
    <li><strong>🧪 آزمایش‌ها و تصویربرداری:</strong> پوشش کامل هزینه‌های آزمایشگاهی، سونوگرافی، ام‌آرآی، سی‌تی‌اسکن و رادیولوژی.</li>
    <li><strong>🦷 خدمات دندانپزشکی و عینک:</strong> پوشش‌های تکمیلی برای خدمات دندانپزشکی و خرید عینک طبی (بر اساس طرح انتخابی).</li>
  </ul>

  <h2>مزایای بیمه تکمیل درمان در منطقه شما</h2>
  <ul>
    <li>✅ طرح‌های متنوع انفرادی و خانواده متناسب با بودجه شما</li>
    <li>✅ امکان استفاده از مراکز درمانی و بیمارستان‌های معتبر طرف قرارداد</li>
    <li>✅ فرآیند ساده و سریع بررسی و پرداخت خسارت</li>
    <li>✅ مشاوره‌ی تخصصی پیش از خرید با علیرضا محمدی (کد ۴۱۶۶۷۲)</li>
    <li>✅ دریافت <strong>هدیه‌ی ۲۰۰ هزار تومانی</strong> به‌ازای ثبت‌نام از طریق سایت</li>
  </ul>

  <div class="highlight-box">
    <strong>🏥 برای انتخاب بهترین طرح بیمه‌ی تکمیل درمان متناسب با بودجه و نیازهای خود در ورامین، پیشوا، قرچک و پاکدشت،</strong> همین حالا با <strong>علیرضا محمدی (کد ۴۱۶۶۷۲)</strong> تماس بگیرید یا فرم مشاوره را پر کنید.
  </div>

  <div class="cta-box">
    <h3>🏥 بهترین بیمه تکمیل درمان را انتخاب کنید</h3>
    <p>با مشاوره رایگان ما، بهترین طرح را با مناسب‌ترین قیمت پیدا کنید.</p>
    <a href="/#form" class="cta-button">دریافت مشاوره رایگان</a>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>