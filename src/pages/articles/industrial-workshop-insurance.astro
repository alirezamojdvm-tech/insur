---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// کلمات کلیدی سئوی محلی و جذب کاربر
const title = "بیمه کارگاه‌های صنعتی سامان در ورامین، پاکدشت، پیشوا و قرچک | پوشش کامل تولیدی‌ها";
const description = "خرید بیمه کارگاه‌های صنعتی و تولیدی سامان با پوشش ماشین‌آلات، مسئولیت کارفرما و حوادث کارگران در ورامین، پیشوا، قرچک و پاکدشت. مشاوره و صدور فوری با علیرضا محمدی (کد ۴۱۶۶۷۲).";

// اسکیما مارک‌آپ پیشرفته برای بیمه کارگاه‌های صنعتی (Local SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "name": "بیمه‌یار - نمایندگی بیمه سامان (کد ۴۱۶۶۷۲)",
  "url": "https://insur.hsc-co.ir",
  "description": "صدور و مشاوره بیمه کارگاه‌های صنعتی سامان در جنوب شرق استان تهران.",
  "areaServed": [
    { "@type": "City", "name": "ورامین" },
    { "@type": "City", "name": "پیشوا" },
    { "@type": "City", "name": "قرچک" },
    { "@type": "City", "name": "پاکدشت" }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "صدور و مشاوره بیمه کارگاه‌های صنعتی"
    }
  },
  "agent": {
    "@type": "Person",
    "name": "علیرضا محمدی"
  }
};
---

<ArticleLayout title={title} description={description} articleTitle={title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- هدر جذاب -->
  <div class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">🏭 ویژه صاحبان کارگاه‌ها و واحدهای تولیدی</span>
      <h1 class="hero-title">با <span class="highlight">بیمه کارگاه‌های صنعتی</span> سامان، از سرمایه‌تان محافظت کنید</h1>
      <p class="hero-desc">
        پوشش کامل ماشین‌آلات، مسئولیت کارفرما، حوادث کارگران و خسارت‌های ناشی از آتش‌سوزی در کارگاه‌ها و واحدهای تولیدی ورامین، پاکدشت، پیشوا و قرچک.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">۱۰۰%</span>
          <span class="stat-label">پوشش ماشین‌آلات</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۵۰۰M+</span>
          <span class="stat-label">سقف پوشش خسارت</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">۲۴h</span>
          <span class="stat-label">بازدید کارشناس</span>
        </div>
      </div>
      <a href="/#form" class="hero-cta">📞 دریافت مشاوره رایگان</a>
    </div>
    <div class="hero-image">
      <div class="hero-icon">🏭</div>
    </div>
  </div>

  <!-- بخش معرفی -->
  <div class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <h2>چرا <span class="highlight">بیمه کارگاه‌های صنعتی</span> در ورامین و قرچک ضروری است؟</h2>
        <p>
          <strong>ورامین، قرچک، پاکدشت و پیشوا</strong> با داشتن شهرک‌های صنعتی متعدد، یکی از قطب‌های مهم تولیدی استان تهران هستند. کارگاه‌ها و واحدهای تولیدی این مناطق با ریسک‌های بالایی مانند آتش‌سوزی، خرابی ماشین‌آلات، حوادث کارگران و مسئولیت‌های حقوقی مواجه هستند.
        </p>
        <p>
          <strong>بیمه کارگاه‌های صنعتی سامان</strong> با ارائه پوشش‌های کامل و تخصصی، یکی از بهترین گزینه‌ها برای تأمین امنیت سرمایه‌های صنعتی شماست. ما در <strong>بیمه‌یار</strong>، خدمات مشاوره تخصصی، <strong>بررسی ریسک‌های کارگاه</strong> و <strong>صدور فوری</strong> را برای همشهریان عزیز در <strong>ورامین، پاکدشت، پیشوا و قرچک</strong> به بهترین شکل ممکن انجام می‌دهیم.
        </p>
      </div>
      <div class="intro-benefits">
        <div class="benefit-card">
          <span class="benefit-icon">⚙️</span>
          <h4>ماشین‌آلات صنعتی</h4>
          <p>پوشش کامل دستگاه‌ها و تجهیزات تولیدی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">👷</span>
          <h4>حوادث کارگران</h4>
          <p>پوشش حوادث ناشی از کار و بیماری‌های شغلی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">🔥</span>
          <h4>آتش‌سوزی و انفجار</h4>
          <p>پوشش کامل خسارت‌های ناشی از آتش‌سوزی</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-icon">⚖️</span>
          <h4>مسئولیت مدنی</h4>
          <p>پوشش خسارت‌های وارده به اشخاص ثالث</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مزایا -->
  <div class="features-section">
    <h2 class="section-title">✨ مزایای <span class="highlight">بیمه کارگاه‌های صنعتی</span> سامان</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">⚙️</div>
        <h4>پوشش ماشین‌آلات و تجهیزات</h4>
        <p>تمام دستگاه‌ها، تجهیزات تولیدی، ابزارآلات و تأسیسات کارگاه در برابر خرابی، آتش‌سوزی و سرقت تحت پوشش قرار می‌گیرند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👷</div>
        <h4>پوشش حوادث کارگران</h4>
        <p>حوادث ناشی از کار، بیماری‌های شغلی و ازکارافتادگی کارگران تحت پوشش کامل این بیمه قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔥</div>
        <h4>پوشش آتش‌سوزی و انفجار</h4>
        <p>خسارت‌های ناشی از آتش‌سوزی، انفجار، صاعقه و برق‌گرفتگی در کارگاه پوشش داده می‌شود.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚖️</div>
        <h4>پوشش مسئولیت مدنی</h4>
        <p>خسارت‌های مالی و جانی وارده به اشخاص ثالث (همسایگان، عابران، مشتریان و ...) تحت پوشش قرار می‌گیرد.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📦</div>
        <h4>پوشش کالا و مواد اولیه</h4>
        <p>مواد اولیه، کالاهای نیم‌ساخته و محصولات نهایی در انبار کارگاه در برابر خسارت پوشش داده می‌شوند.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h4>بازدید و کارشناسی سریع</h4>
        <p>کارشناسان ما در کمتر از ۲۴ ساعت در محل حاضر شده و خسارت‌ها را بررسی می‌کنند.</p>
      </div>
    </div>
  </div>

  <!-- بخش انواع کارگاه‌ها -->
  <div class="types-section">
    <h2 class="section-title">🏭 انواع <span class="highlight">کارگاه‌های صنعتی</span> تحت پوشش</h2>
    <div class="types-grid">
      <div class="type-card">
        <span class="type-icon">🔩</span>
        <h4>کارگاه‌های فلزکاری</h4>
        <p>جوشکاری، تراشکاری، آهنگری، ساخت قطعات فلزی و ماشین‌سازی</p>
        <ul>
          <li>پوشش دستگاه‌های CNC</li>
          <li>پوشش جرثقیل و بالابر</li>
          <li>پوشش حوادث کارگران</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🪚</span>
        <h4>کارگاه‌های چوب و نجاری</h4>
        <p>تولید مبلمان، کابینت، سازه‌های چوبی و صنایع دستی</p>
        <ul>
          <li>پوشش آتش‌سوزی و انفجار</li>
          <li>پوشش ماشین‌آلات برقی</li>
          <li>پوشش مواد اولیه</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🧵</span>
        <h4>کارگاه‌های نساجی و پوشاک</h4>
        <p>تولید پارچه، پوشاک، کیف و کفش و صنایع مرتبط</p>
        <ul>
          <li>پوشش آتش‌سوزی (ریسک بالا)</li>
          <li>پوشش ماشین‌آلات دوخت</li>
          <li>پوشش مواد اولیه</li>
        </ul>
      </div>
      <div class="type-card">
        <span class="type-icon">🏗️</span>
        <h4>کارگاه‌های ساختمانی</h4>
        <p>ساخت و ساز، نوسازی، راه‌سازی و پروژه‌های عمرانی</p>
        <ul>
          <li>پوشش ماشین‌آلات سنگین</li>
          <li>پوشش حوادث کارگران</li>
          <li>پوشش مسئولیت مدنی</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- بخش پوشش‌ها -->
  <div class="coverage-section">
    <h2 class="section-title">🛡️ پوشش‌های <span class="highlight">بیمه کارگاه‌های صنعتی</span> سامان</h2>
    <div class="coverage-grid">
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>ماشین‌آلات و تجهیزات</h4>
          <p>خرابی، آتش‌سوزی، سرقت و حوادث</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>حوادث کارگران</h4>
          <p>حوادث ناشی از کار، بیماری‌های شغلی</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>آتش‌سوزی و انفجار</h4>
          <p>خسارت‌های ناشی از آتش، انفجار، صاعقه</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>مسئولیت مدنی</h4>
          <p>خسارت به اشخاص ثالث و همسایگان</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>کالا و مواد اولیه</h4>
          <p>مواد اولیه، کالاهای نیم‌ساخته و محصولات</p>
        </div>
      </div>
      <div class="coverage-item">
        <span class="coverage-icon">✅</span>
        <div>
          <h4>هزینه‌های حقوقی</h4>
          <p>دادرسی، وکالت و مشاوره حقوقی</p>
        </div>
      </div>
    </div>
  </div>

  <!-- بخش مدارک و مراحل -->
  <div class="process-section">
    <h2 class="section-title">📋 مراحل <span class="highlight">ثبت‌نام</span> بیمه کارگاه صنعتی</h2>
    <div class="process-grid">
      <div class="process-item">
        <span class="process-number">۱</span>
        <h4>مشاوره رایگان</h4>
        <p>تماس با کارشناسان برای بررسی ریسک‌های کارگاه</p>
      </div>
      <div class="process-item">
        <span class="process-number">۲</span>
        <h4>بازدید از کارگاه</h4>
        <p>کارشناسان ما از کارگاه بازدید کرده و ریسک‌ها را ارزیابی می‌کنند</p>
      </div>
      <div class="process-item">
        <span class="process-number">۳</span>
        <h4>تعیین حق بیمه</h4>
        <p>محاسبه حق بیمه بر اساس نوع فعالیت و ریسک‌ها</p>
      </div>
      <div class="process-item">
        <span class="process-number">۴</span>
        <h4>صدور بیمه‌نامه</h4>
        <p>صدور بیمه‌نامه پس از تأیید و پرداخت</p>
      </div>
    </div>
  </div>

  <!-- بخش FAQ -->
  <div class="faq-section">
    <h2 class="section-title">❓ سوالات <span class="highlight">متداول</span> صاحبان کارگاه</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>آیا بیمه کارگاه صنعتی، خسارت ناشی از قطعی برق را پوشش می‌دهد؟</h4>
        <p>بله، برخی از طرح‌های بیمه کارگاه‌های صنعتی سامان شامل پوشش خسارت‌های ناشی از قطعی برق، نوسانات ولتاژ و برق‌گرفتگی می‌شوند. برای اطلاع از جزئیات، با کارشناسان ما تماس بگیرید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه کارگاه، کارگران پیمانی را نیز پوشش می‌دهد؟</h4>
        <p>بله، در صورتی که کارگران پیمانی تحت نظارت و مدیریت کارفرما فعالیت کنند، تحت پوشش بیمه کارگاه قرار می‌گیرند. برای اطلاع از شرایط، با کارشناسان ما مشورت کنید.</p>
      </div>
      <div class="faq-item">
        <h4>آیا بیمه کارگاه، هزینه‌های تعمیرات ماشین‌آلات را پوشش می‌دهد؟</h4>
        <p>بله، بیمه کارگاه‌های صنعتی سامان شامل پوشش هزینه‌های تعمیرات ماشین‌آلات و تجهیزات در صورت خرابی ناشی از حوادث می‌شود.</p>
      </div>
      <div class="faq-item">
        <h4>آیا می‌توانم بیمه کارگاه را به صورت اقساطی خریداری کنم؟</h4>
        <p>بله، شما می‌توانید بیمه کارگاه صنعتی را به صورت نقدی یا اقساطی خریداری کنید. برای اطلاع از شرایط پرداخت، با کارشناسان ما تماس بگیرید.</p>
      </div>
    </div>
  </div>

  <!-- CTA نهایی -->
  <div class="cta-section">
    <div class="cta-content">
      <h2>🏭 با <span class="highlight-light">بیمه کارگاه صنعتی</span> سامان از سرمایه‌تان محافظت کنید</h2>
      <p>با ثبت‌نام در بیمه کارگاه‌های صنعتی سامان، از پوشش کامل ماشین‌آلات، حوادث کارگران و مسئولیت مدنی بهره‌مند شوید و خیال خود را از بابت ریسک‌های تولید راحت کنید.</p>
      <div class="cta-buttons">
        <a href="/#form" class="cta-primary">📞 دریافت مشاوره رایگان</a>
        <a href="tel:09123456789" class="cta-secondary">📱 تماس فوری: ۰۹۱۲۳۴۵۶۷۸۹</a>
      </div>
      <p class="cta-note">🎁 به ازای هر ثبت‌نام، <strong>۲۰۰ هزار تومان هدیه نقدی</strong> دریافت کنید</p>
    </div>
  </div>

  <a href="/" class="back-button">← بازگشت به صفحه اصلی</a>
</ArticleLayout>

<style>
  /* ===== هدر اصلی ===== */
  .hero-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    border-radius: 24px;
    padding: 40px 48px;
    margin: 20px 0 40px;
    color: white;
    gap: 30px;
  }
  .hero-content {
    flex: 1 1 55%;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.12);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .hero-title .highlight {
    color: #fcd34d;
    text-shadow: 0 2px 8px rgba(252,211,77,0.3);
  }
  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #fcd34d;
  }
  .stat-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .hero-cta {
    display: inline-block;
    background: white;
    color: #1e293b;
    padding: 14px 32px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
  .hero-image {
    flex: 0 0 120px;
    text-align: center;
  }
  .hero-icon {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== بخش معرفی ===== */
  .intro-section {
    margin: 40px 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .intro-text h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .intro-text p {
    line-height: 1.8;
    color: #333;
    margin-bottom: 12px;
  }
  .intro-text .highlight {
    color: #1e293b;
    font-weight: 700;
  }
  .intro-benefits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .benefit-card {
    background: #f8fafc;
    padding: 20px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }
  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    border-color: #fcd34d;
  }
  .benefit-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 8px;
  }
  .benefit-card h4 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 4px;
    color: #1e293b;
  }
  .benefit-card p {
    font-size: 0.85rem;
    color: #4b5563;
    margin: 0;
  }

